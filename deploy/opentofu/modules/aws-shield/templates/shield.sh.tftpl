#!/bin/bash
# EC2-SHIELD (cloud-init, F6): Docker + imagen OCI de celeris-node fijada por digest + configuración por volumen.
set -eu
export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y docker.io ca-certificates
install -d -m 0755 /etc/celeris
install -d -o 65532 -g 65532 -m 0750 /var/lib/celeris
cat > /etc/celeris/config.toml <<'CONF'
listen = "${ip}:${puerto_f9}"
allowed_clients = [${clientes}]
operator_contact = "redes@example.invalid"
data_dir = "/data/store"
ca_cert = "/data/ca/celeris-ca.crt"
ca_key = "/data/ca/celeris-ca.key"
admin_listen = "${ip}:${puerto_admin}"
admin_token_file = "/data/admin.token"
admin_tls = true
admin_tls_cert = "/data/ca/admin-tls.crt"
admin_tls_key = "/data/ca/admin-tls.key"
CONF
systemctl enable --now docker
docker run -d --name celeris-node --restart unless-stopped --network host \
  -v /etc/celeris:/config:ro -v /var/lib/celeris:/data ${imagen} /config/config.toml
