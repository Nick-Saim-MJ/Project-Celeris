@startuml DS-03-clases-control
!include _estilo.iuml
title DS-03 · Clases de diseño de celeris-console (CE02 C3.3, arquitectura v0.4)
caption Todo «R2 — diseño»: la consola no existe aún (se construye en S2). API axum + SPA + PostgreSQL local, todo en CTRL01 10.20.20.10 (D-25).
left to right direction

package "Entrada HTTP (axum, TLS 443)" {
  class ApiRouter <<R2>> {
    + rutas /v1/* para la SPA (F28 desde ENC01, F30 desde EC2-GW)
    + rutas /v1/nodos/* para los nodos (F10, 8443 mTLS)
  }
  class OrigenMiddleware <<R2>> {
    + origen(req): campus | remoto
    remoto = trae el certificado de cliente de EC2-GW
  }
}

package "auth" {
  class AuthService <<R2>> {
    + login(usuario, contraseña, totp): Sesion
    + bloquear_tras_intentos(usuario)
  }
  class Rbac <<R2>> {
    + puede(sesion, laboratorio): bool
    + exigir_campus(sesion, accion_critica)
  }
}

package "catalog" {
  class CatalogService <<R2>> {
    + crear_fuente(sesion, datos): Fuente
    + simular(url): Simulacion
    + aprobar(sesion, fuente)
    + rechazar(sesion, fuente)
  }
  class ReglasCatalogo <<R2>> {
    + nunca_gana(dominio): bool
    + ca_cubre(nodo, dominio): bool
    + es_fija(fuente): bool
  }
}

package "labs" {
  class LabsService <<R2>> {
    + actualizar(sesion, lab, habilitado, horario)
  }
}

package "prefetch" {
  class PrefetchService <<R2>> {
    + programar(sesion, lab, urls, fecha): Precarga
    + desde_solicitud(sesion, solicitud): Precarga
    + registrar_avance(nodo, precarga, bytes, estado)
  }
  class SolicitudService <<R2>> {
    + registrar(docente, lab, fecha_clase, descripcion)
    + responder(sesion, solicitud, mensaje)
  }
}

package "publisher" {
  class Publisher <<R2>> {
    + compilar(): VersionConfig
    + generar_pac(nodos_activos)
    + generar_portal(version): SitioFirmado
  }
  class FirmaEd25519 <<R2>> {
    + firmar(bytes): Firma
    la llave de firma no sale de CTRL01
  }
}

package "reports" {
  class ReportsService <<R2>> {
    + recibir_kpi(nodo, KpiIntervalo)
    + ahorro(lab, desde, hasta): Reporte
    + en_vivo(labs): VistaEnVivo
  }
}

package "audit" {
  class AuditLog <<R2>> {
    + registrar(sesion, accion, objeto, antes, despues)
    solo inserción: sin update ni delete
  }
}

package "Persistencia" {
  class Repositorio <<R2>> {
    PostgreSQL local por socket Unix (D-12)
    tablas en DS-12
  }
}

ApiRouter --> OrigenMiddleware
ApiRouter --> AuthService
OrigenMiddleware ..> Rbac : marca la sesión
CatalogService --> Rbac : exigir_campus(aprobar)
CatalogService --> ReglasCatalogo
LabsService --> Rbac : puede(lab)
PrefetchService --> Rbac
SolicitudService --> PrefetchService : convierte
CatalogService --> Publisher
LabsService --> Publisher
PrefetchService --> Publisher
Publisher --> FirmaEd25519
ApiRouter --> ReportsService : POST /v1/nodos/{id}/kpi
ApiRouter --> Publisher : GET /v1/nodos/{id}/config
CatalogService --> AuditLog
LabsService --> AuditLog
PrefetchService --> AuditLog
Publisher --> AuditLog
AuthService --> AuditLog : intentos y 403
CatalogService --> Repositorio
LabsService --> Repositorio
PrefetchService --> Repositorio
ReportsService --> Repositorio
AuditLog --> Repositorio

note right of Rbac
  Acciones críticas (REQ-F-37): aprobar fuentes a descifrar,
  rotar llaves, gestionar usuarios, cambiar el perfil BYOD.
  Desde «remoto» → 403 y queda en la auditoría (T54).
end note
note right of Publisher
  La configuración incluye las redes BYOD (WIFI-EST)
  en modo «nunca»; no existe opción para cambiarlo
  (REQ-F-36, REQ-RN-11). El sitio del portal lo despliega
  JMP01 en PORTAL01 por F20.
end note

$pie("DS-03", "REQ-F-17, F-20, F-24, F-25, F-26, F-30…F-37, RN-03, RN-04, RN-06, RN-07, RN-09…RN-11", "CU-03…CU-07, CU-09…CU-11", "P-01…P-08, P-11")
@enduml
