@startuml DS-05-secuencia-connect-sni
!include _estilo.iuml
title DS-05 · Secuencia: CONNECT y decisión de descifrado por SNI (REQ-F-02, implementado; BYOD y catálogo en R2)
caption «R1»: handler.rs (guard_connect, should_intercept_connect, should_intercept_tls, tls_decision) y config.rs (should_intercept).

actor "Cliente\n(LAB o WIFI-EST)" as C
box "celeris-node · EDGE01 10.20.60.10" #FFFFFF
  participant "Hudsucker\n(D-02)" as HS <<R1>>
  participant "CacheHandler" as H <<R1>>
  participant "Config\n(política)" as P <<R1>>
  participant "DestinationPolicy\n(access.rs)" as D <<R1>>
  participant "Detector +\nSecurityLog" as DET <<R1>>
end box
participant "Origen" as O

C -> HS : CONNECT cdn.example:443
HS -> H : handle_request(CONNECT)
H -> H : clients.check(ip)
alt cliente fuera de allowed_clients o límite por minuto
  H --> C : 403 / 429 + Retry-After: 60 (REQ-F-10)
end
H -> H : guard_connect: connect_port_allowed(443)
alt puerto no permitido
  H -> DET : rare_port(ip, puerto) + evento port_blocked
  H --> C : 403 (REQ-F-11)
end
H -> D : resolve(host, 443)
alt resuelve a una IP interna (SSRF)
  H -> DET : evento destination_blocked
  H --> C : 403 (REQ-F-11)
end
HS -> H : should_intercept_connect(cdn.example)
alt la IP de origen está en una red BYOD (WIFI-EST, F31) «R2»
  H --> HS : false → túnel sin descifrar, sea cual sea la fuente
  note right of H : REQ-F-36 / REQ-RN-11: hoy never_intercept es por dominio;\nen R2 la configuración firmada trae la lista de redes BYOD.
end
H -> P : should_intercept(host)
note right of P : R1: intercept_domains / never_intercept de config.toml.\nR2: solo descifra una fuente descifrar_y_cachear activa;\n«nunca» gana siempre (REQ-RN-03)

alt dominio no listado o en never_intercept
  P --> H : false
  H --> HS : false → túnel a la IP ya validada
  HS <-> O : TLS de extremo a extremo (sin descifrar)
  note right of H : Outcome::Tunnel, stats.tls_passthrough
else dominio en intercept_domains
  P --> H : true; connect_host = cdn.example
  C -> HS : ClientHello (SNI)
  HS -> H : should_intercept_tls(hello)
  H -> H : tls_decision(cfg, sni, connect_host)
  alt SNI ≠ CONNECT (canonical_host)
    H -> DET : host_mismatch(ip, "El SNI no coincide…")
    H --> HS : false → no se descifra
    HS <-> O : túnel sin descifrar
  else SNI = CONNECT y SNI en la lista
    H --> HS : true
    HS -> HS : certificado de hoja firmado por la CA\ncon Name Constraints (REQ-F-18 parcial)
    HS --> C : TLS 1.2+ (X25519MLKEM768 preferido, REQ-NF-06)
    note over C, H : Siguen las peticiones HTTP descifradas (DS-04, DS-06)
  end
end

note over H, P : Por defecto no se descifra: sin SNI, sin coincidencia o con SNI distinto, tls_decision devuelve false.\nREQ-NF-08: ante un error del motor de políticas tampoco se descifra (prueba de inyección de fallos en R2).

$pie("DS-05", "REQ-F-01, F-02, F-10, F-11, F-15, F-18, F-36, RN-03, RN-11, NF-06, NF-08", "CU-01, CU-03", "P-03, P-04, P-09")
@enduml
