@startuml DS-12-modelo-datos
!include _estilo.iuml
title DS-12 · Modelo de datos de la consola (CE02 C4.8, PostgreSQL local en CTRL01 10.20.20.10)
caption «R2 — diseño», base para CE022 (S2). PK = clave primaria, FK = clave foránea. «nueva» = no está en C4.8 (hueco H-10, ver README).
skinparam linetype ortho

entity usuario {
  * id : uuid <<PK>>
  --
  * nombre : text <<unique>>
  * rol : text (encargado | admin | auditor | docente)
  * hash_contraseña : text
  * totp_secreto_cifrado : bytea
  * bloqueado_hasta : timestamptz
}
entity asignacion {
  * usuario_id : uuid <<FK>>
  * laboratorio_id : smallint <<FK>>
  --
  PK (usuario_id, laboratorio_id)
}
entity laboratorio {
  * id : smallint <<PK>>
  --
  * nombre : text (LAB-01 … LAB-10)
  * rango_cidr : cidr (del inventario, solo lectura)
  * habilitado : boolean
  horario : jsonb
}
entity sesion <<nueva>> {
  * id : uuid <<PK>>
  --
  * usuario_id : uuid <<FK>>
  * origen : text (campus | remoto)
  * equipo : text (ENC01 | JMP01 | EC2-GW)
  * vence : timestamptz
}
entity fuente {
  * id : uuid <<PK>>
  --
  * nombre : text
  * categoria : text
  * modo : text (cachear | descifrar_y_cachear | nunca)
  * estado : text (DS-17)
  * fija : boolean (lista DTI, REQ-RN-09)
}
entity fuente_dominio {
  * fuente_id : uuid <<FK>>
  * sufijo : text
  --
  PK (fuente_id, sufijo)
}
entity aprobacion {
  * id : uuid <<PK>>
  --
  * objeto_tipo : text (fuente | rotacion_ca)
  * objeto_id : uuid
  * decision : text (aprobada | rechazada)
  * por : uuid <<FK>> (usuario admin)
  * sesion_id : uuid <<FK>>
  * fecha : timestamptz
  ..
  CHECK: la sesión es de origen campus (REQ-F-37)
}
entity solicitud {
  * id : text <<PK>> (SOL-12…)
  --
  * docente_id : uuid <<FK>> (rol docente, H-03)
  * laboratorio_id : smallint <<FK>>
  * fecha_clase : timestamptz
  * descripcion : text
  * estado : text
  precarga_id : uuid <<FK>>
}
entity precarga {
  * id : uuid <<PK>>
  --
  * laboratorio_id : smallint <<FK>>
  * fecha : date
  * ventana_inicio, ventana_fin : time
  * estado : text (DS-18)
  bytes_total : bigint
  fuente_id : uuid <<FK>>
}
entity precarga_item {
  * precarga_id : uuid <<FK>>
  * url_sin_query : text
  --
  sha256 : bytea
  * estado : text
}
entity version_config {
  * version : bigint <<PK>>
  --
  * contenido : jsonb
  * firma : bytea (ed25519)
  * publicada_por : uuid <<FK>>
  * publicada_en : timestamptz
  ..
  inmutable: sin UPDATE ni DELETE
}
entity nodo {
  * id : text <<PK>> (EDGE01, EDGE02)
  --
  * version_aplicada : bigint <<FK>>
  * ultimo_informe : timestamptz
}
entity ca_intermedia <<nueva>> {
  * serie : text <<PK>>
  --
  * nodo_id : text <<FK>>
  * vence : timestamptz
  * huella_sha256 : text
  * name_constraints : text[]
}
entity kpi_intervalo <<nueva>> {
  * nodo_id : text <<FK>>
  * laboratorio_id : smallint <<FK>>
  * ts : timestamptz
  --
  hit, revalidated, miss, bypass : int
  rechazos_403 : int
  bytes_cache, bytes_origen : bigint
}
entity kpi_diario {
  * fecha : date
  * laboratorio_id : smallint <<FK>>
  * fuente_id : uuid <<FK>>
  --
  bytes_cache, bytes_origen : bigint
  hits, misses : bigint
}
entity cambio {
  * id : bigserial <<PK>>
  --
  * usuario_id : uuid <<FK>>
  * sesion_id : uuid <<FK>>
  * accion : text
  * objeto : text
  antes, despues : jsonb
  resultado : text (aplicado | rechazado_403)
  * fecha : timestamptz
  ..
  solo inserción (REQ-F-24)
}

usuario ||--o{ asignacion
laboratorio ||--o{ asignacion
usuario ||--o{ sesion
fuente ||--|{ fuente_dominio
fuente ||--o{ aprobacion
usuario ||--o{ aprobacion
laboratorio ||--o{ solicitud
usuario ||--o{ solicitud
solicitud |o--o| precarga
laboratorio ||--o{ precarga
precarga ||--|{ precarga_item
fuente |o--o{ precarga
version_config ||--o{ nodo
nodo ||--o{ ca_intermedia
nodo ||--o{ kpi_intervalo
laboratorio ||--o{ kpi_intervalo
laboratorio ||--o{ kpi_diario
fuente ||--o{ kpi_diario
sesion ||--o{ cambio
usuario ||--o{ cambio

note bottom of kpi_intervalo
  Ningún campo identifica a una PC o a una persona
  (REQ-NF-07, D-22). Fuente de P-11 y, agregada por día, de kpi_diario.
end note
note bottom of version_config
  Incluye laboratorios, fuentes activas, precargas, órdenes
  de purga (REQ-F-19) y la red WIFI-EST en «nunca» (REQ-RN-11).
  Los nodos la piden por F10.
end note

$pie("DS-12", "REQ-F-17, F-18, F-19, F-24, F-25, F-31…F-35, F-37, NF-07, RN-06, RN-07, RN-09, RN-11", "CU-03…CU-07, CU-09…CU-11", "P-01…P-08, P-11")
@enduml
