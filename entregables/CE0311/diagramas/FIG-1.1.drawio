        <object id="FIG-1.1-7" label="&lt;b&gt;Caché EDGE01 10.20.60.10 y EDGE02 10.20.60.11&lt;/b&gt;&lt;br&gt;zona EDGE · 10.20.60.0/24&lt;br&gt;&lt;i&gt;Proxy de caché explícito en TCP 3128&lt;/i&gt;" celeris_id="EDGE" celeris_tipo="zona" celeris_incluye="EDGE01,EDGE02">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#4D4D4D;strokeWidth=2;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;spacing=6;spacingLeft=6;" parent="1" vertex="1">
