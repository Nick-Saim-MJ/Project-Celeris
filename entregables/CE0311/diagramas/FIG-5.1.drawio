        <mxCell style="shape=mxgraph.networks.switch;fillColor=#CCCCCC;strokeColor=#4D4D4D;html=1;aspect=fixed;outlineConnect=0;dashed=0;" parent="1" vertex="1" id="FIG-5.1-53" value="">
