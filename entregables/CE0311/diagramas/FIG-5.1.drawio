        <object id="FIG-5.1-43" label="&lt;b&gt;OBS01&lt;/b&gt; · Observabilidad · &lt;b&gt;MEDIA&lt;/b&gt;&lt;br&gt;10.20.20.20&lt;br&gt;&lt;i&gt;Métricas y trazas de los nodos&lt;/i&gt;" celeris_id="OBS01" celeris_tipo="componente" ip="10.20.20.20" zona="SERVERS" criticidad="Media" estado="diseño" por_que="Recibe las trazas y métricas OTLP de los nodos (F11) y hace el scraping de Prometheus (F12); da la medición que sustenta la meta de adopción del proxy." aporta="Recibe TCP 4317/4318 (F11); consulta TCP 9128 y 9100 con TLS obligatorio (F12) hacia EDGE01/02, CTRL01 y EC2-SHIELD; Grafana en el puerto 3000 (F20)." si_falla="Se pierde la visibilidad de métricas, no el servicio. Mitigación: los registros de acceso de Celeris y el SIEM siguen disponibles." flujos="F11, F12, F13, F17" pruebas="T11, T18, T27" placeholders="1" tooltip="OBS01 · Media&#10;Por qué: Recibe las trazas y métricas OTLP de los nodos (F11) y hace el scraping de Prometheus (F12); da la medición que sustenta la meta de adopción del proxy.&#10;Aporta: Recibe TCP 4317/4318 (F11); consulta TCP 9128 y 9100 con TLS obligatorio (F12) hacia EDGE01/02, CTRL01 y EC2-SHIELD; Grafana en el puerto 3000 (F20).&#10;Si falla: Se pierde la visibilidad de métricas, no el servicio. Mitigación: los registros de acceso de Celeris y el SIEM siguen disponibles.">
          <mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#009E73;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=32;spacingTop=1;spacingRight=2;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
            <mxGeometry x="660" y="610" width="180" height="84" as="geometry" />
          </mxCell>
