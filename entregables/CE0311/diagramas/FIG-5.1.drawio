        <object id="FIG-5.1-21" label="&lt;b&gt;VLAN 50 · SECURITY&lt;/b&gt; · 10.20.50.0/24 · confianza Alta" celeris_id="SECURITY" celeris_tipo="zona" cidr="10.20.50.0/24" vlan="50" gateway="10.20.50.1" confianza="Alta" proposito="Wazuh, sensor Suricata" tooltip="SECURITY: Wazuh, sensor Suricata. Regla: Recibe de todos, no inicia hacia ninguno salvo NTP/DNS y feeds">
