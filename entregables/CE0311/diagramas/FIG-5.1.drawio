        <object id="FIG-5.1-26" label="&lt;b&gt;EDGE01&lt;/b&gt; · Nodo Celeris 1 · &lt;b&gt;ALTA&lt;/b&gt;&lt;br&gt;10.20.60.10&lt;br&gt;&lt;i&gt;Proxy de caché explícito en TCP 3128&lt;/i&gt;" celeris_id="EDGE01" celeris_tipo="componente" ip="10.20.60.10" zona="EDGE" criticidad="Alta" estado="diseño" por_que="Es el proxy de caché que reduce las descargas repetidas por el enlace de 300 Mbps [S-02]; atiende TCP 3128 de LAB (F1) y, sin descifrar, de WIFI-EST (F31)." aporta="Cachea según RFC 9111, descifra solo dominios listados, sale a Internet por TCP 80/443 vía el FortiGate (F8) y recibe configuración firmada de CTRL01 por 8443 (F10); sirve el PAC en TCP 80 (F3) con dos registros A (EDGE01 y EDGE02); para WIFI-EST siempre passthrough (REQ-F-36); administración y métricas en 9128." si_falla="El PAC conmuta a EDGE02 y, si ambos caen, a DIRECT (T09); en el piloto F6 lo permite. Mitigación: dos nodos y DIRECT." flujos="F1, F3, F13, F31" pruebas="T05, T07, T09, T11, T13, T14, T18, T19, T26, T27, T30, T31, T34, T36, T45, T46, T47, T50, T51, T52, T55, T56, T57, T58, T60" placeholders="1" tooltip="EDGE01 · Alta&#10;Por qué: Es el proxy de caché que reduce las descargas repetidas por el enlace de 300 Mbps [S-02]; atiende TCP 3128 de LAB (F1) y, sin descifrar, de WIFI-EST (F31).&#10;Aporta: Cachea según RFC 9111, descifra solo dominios listados, sale a Internet por TCP 80/443 vía el FortiGate (F8) y recibe configuración firmada de CTRL01 por 8443 (F10); sirve el PAC en TCP 80 (F3) con dos registros A (EDGE01 y EDGE02); para WIFI-EST siempre passthrough (REQ-F-36); administración y métricas en 9128.&#10;Si falla: El PAC conmuta a EDGE02 y, si ambos caen, a DIRECT (T09); en el piloto F6 lo permite. Mitigación: dos nodos y DIRECT.">
          <mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=32;spacingTop=1;spacingRight=2;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
            <mxGeometry x="470" y="566" width="180" height="84" as="geometry" />
          </mxCell>
        </object>
        <mxCell style="shape=mxgraph.networks.server;fillColor=#CCCCCC;strokeColor=#4D4D4D;html=1;aspect=fixed;outlineConnect=0;dashed=0;" parent="1" vertex="1" id="FIG-5.1-27" value="">
          <mxGeometry x="475" y="572" width="22" height="22" as="geometry" />
        </mxCell>
        <object id="FIG-5.1-28" label="&lt;b&gt;EDGE02&lt;/b&gt; · Nodo Celeris 2 · &lt;b&gt;ALTA&lt;/b&gt;&lt;br&gt;10.20.60.11&lt;br&gt;&lt;i&gt;Redundancia del proxy: segunda ruta del PAC&lt;/i&gt;" celeris_id="EDGE02" celeris_tipo="componente" ip="10.20.60.11" zona="EDGE" criticidad="Alta" estado="diseño" por_que="Segunda ruta de salida del PAC: cumple la meta de ≥ 3 rutas por usuario (EDGE01, EDGE02, DIRECT) y cubre el mantenimiento de EDGE01." aporta="Misma función y puertos que EDGE01 (F1, F3, F8, F10, F31), con su propio datastore NVMe de caché; se despliega en la fase F2 y sirve el segundo registro A del PAC." si_falla="El PAC usa EDGE01; con ambos caídos, DIRECT (T09)." flujos="F1, F3, F13, F31" pruebas="T05, T07, T09, T11, T13, T14, T18, T19, T30, T31, T47, T51, T52, T55, T56, T57, T58, T60" placeholders="1" tooltip="EDGE02 · Alta&#10;Por qué: Segunda ruta de salida del PAC: cumple la meta de ≥ 3 rutas por usuario (EDGE01, EDGE02, DIRECT) y cubre el mantenimiento de EDGE01.&#10;Aporta: Misma función y puertos que EDGE01 (F1, F3, F8, F10, F31), con su propio datastore NVMe de caché; se despliega en la fase F2 y sirve el segundo registro A del PAC.&#10;Si falla: El PAC usa EDGE01; con ambos caídos, DIRECT (T09).">
          <mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=32;spacingTop=1;spacingRight=2;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
            <mxGeometry x="660" y="566" width="180" height="84" as="geometry" />
          </mxCell>
        </object>
        <mxCell style="shape=mxgraph.networks.server;fillColor=#CCCCCC;strokeColor=#4D4D4D;html=1;aspect=fixed;outlineConnect=0;dashed=0;" parent="1" vertex="1" id="FIG-5.1-29" value="">
          <mxGeometry x="665" y="572" width="22" height="22" as="geometry" />
