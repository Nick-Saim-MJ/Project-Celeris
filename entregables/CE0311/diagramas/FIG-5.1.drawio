        <object id="FIG-5.1-49" label="&lt;b&gt;VLAN 10 · MGMT&lt;/b&gt; · 10.20.10.0/24 · confianza Máxima · GW 10.20.10.1" celeris_id="MGMT" celeris_tipo="zona" cidr="10.20.10.0/24" vlan="10" gateway="10.20.10.1" confianza="Máxima" proposito="Gestión de ESXi, switch, IPMI, UPS, JMP01; puerto break-glass" tooltip="MGMT: Gestión de ESXi, switch, IPMI, UPS, JMP01; puerto break-glass. Regla: Solo JMP01 inicia conexiones; MFA en JMP01 y en la GUI de OPNsense">
