        <object id="FIG-5.1-25" label="&lt;b&gt;VLAN 60 · EDGE&lt;/b&gt; · 10.20.60.0/24 · confianza Media · GW 10.20.60.1" celeris_id="EDGE" celeris_tipo="zona" cidr="10.20.60.0/24" vlan="60" gateway="10.20.60.1" confianza="Media" proposito="Nodos Celeris" tooltip="EDGE: Nodos Celeris. Regla: Recibe 3128 y 80 de LAB y de WIFI-EST (esta sin descifrar); sale a Internet (F8) y a CTRL01 (F10)">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#4D4D4D;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=11;fontColor=#1A1A1A;" parent="1" vertex="1">
