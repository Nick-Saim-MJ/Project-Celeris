        <object id="FIG-5.1-58" label="&lt;b&gt;IPMI01&lt;/b&gt; · iDRAC/iLO · &lt;b&gt;MEDIA&lt;/b&gt;&lt;br&gt;10.20.10.11&lt;br&gt;&lt;i&gt;Consola remota del servidor sin depender de ESXi&lt;/i&gt;" celeris_id="IPMI01" celeris_tipo="componente" ip="10.20.10.11" zona="MGMT" criticidad="Media" estado="diseño" por_que="Permite encender, apagar y ver la consola del servidor aunque ESXi y FW01 no estén disponibles." aporta="Acceso de recuperación en T25 desde BRK01; solo es alcanzable desde JMP01 (F20) o desde el puerto break-glass." si_falla="Sin consola remota la recuperación del servidor exige presencia física. Mitigación: BRK01 y acceso físico al rack." flujos="F20" pruebas="T06, T25, T27, T34, T54" placeholders="1" tooltip="IPMI01 · Media&#10;Por qué: Permite encender, apagar y ver la consola del servidor aunque ESXi y FW01 no estén disponibles.&#10;Aporta: Acceso de recuperación en T25 desde BRK01; solo es alcanzable desde JMP01 (F20) o desde el puerto break-glass.&#10;Si falla: Sin consola remota la recuperación del servidor exige presencia física. Mitigación: BRK01 y acceso físico al rack.">
          <mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0072B2;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=32;spacingTop=1;spacingRight=2;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
