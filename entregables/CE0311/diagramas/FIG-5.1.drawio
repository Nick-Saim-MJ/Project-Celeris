        <object id="FIG-5.1-41" label="&lt;b&gt;DB01&lt;/b&gt; · PostgreSQL · &lt;b&gt;ALTA&lt;/b&gt;&lt;br&gt;10.20.20.11&lt;br&gt;&lt;i&gt;Base primaria del plano de control&lt;/i&gt;" celeris_id="DB01" celeris_tipo="componente" ip="10.20.20.11" zona="SERVERS" criticidad="Alta" estado="diseño" por_que="Guarda el estado del plano de control; su réplica nativa a AWS (F16) da continuidad ante la pérdida del servidor del campus." aporta="Atiende TCP 5432 con TLS y scram-sha-256 desde CTRL01 (F15) y desde EC2-CTRLR (F16, TLS verify-full); respaldo con pgBackRest y WAL a S3 (F18)." si_falla="El plano de control deja de leer y escribir. Mitigación: réplica en EC2-CTRLR (F16), RTO 2 h y RPO 15 min (D2.9)." flujos="F13, F15, F16, F17, F18" pruebas="T02, T05, T11, T18, T21" placeholders="1" tooltip="DB01 · Alta&#10;Por qué: Guarda el estado del plano de control; su réplica nativa a AWS (F16) da continuidad ante la pérdida del servidor del campus.&#10;Aporta: Atiende TCP 5432 con TLS y scram-sha-256 desde CTRL01 (F15) y desde EC2-CTRLR (F16, TLS verify-full); respaldo con pgBackRest y WAL a S3 (F18).&#10;Si falla: El plano de control deja de leer y escribir. Mitigación: réplica en EC2-CTRLR (F16), RTO 2 h y RPO 15 min (D2.9).">
          <mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#009E73;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=32;spacingTop=1;spacingRight=2;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
            <mxGeometry x="850" y="516" width="180" height="84" as="geometry" />
          </mxCell>
        </object>
        <mxCell style="shape=mxgraph.networks.server;fillColor=#CCCCCC;strokeColor=#4D4D4D;html=1;aspect=fixed;outlineConnect=0;dashed=0;" parent="1" vertex="1" id="FIG-5.1-42" value="">
          <mxGeometry x="855" y="522" width="22" height="22" as="geometry" />
