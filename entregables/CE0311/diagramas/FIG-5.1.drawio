        <object id="FIG-5.1-68" label="&lt;b&gt;AWS&lt;/b&gt; · zona AWS · confianza Baja&lt;br&gt;10.30.0.0/16" celeris_id="AWS" celeris_tipo="zona" cidr="10.30.0.0/16" confianza="Baja" proposito="VPC celeris (10.30.0.0/16): EC2-GW (panel remoto), S3 de respaldos y subred privada vacía para el simulacro de recuperación" tooltip="AWS: VPC celeris (10.30.0.0/16): EC2-GW (panel remoto), S3 de respaldos y subred privada vacía para el simulacro de recuperación. Regla: Alcanzable solo por VPN desde el campus; desde Internet solo EC2-GW:443; Security Groups y NACL de D2.5">
          <mxCell style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=30;fontSize=11;fontColor=#232F3E;container=0;dashed=0;" parent="1" vertex="1">
