        <object id="FIG-5.1-45" label="&lt;b&gt;SVC01&lt;/b&gt; · DNS, PAC y NTP · &lt;b&gt;ALTA&lt;/b&gt;&lt;br&gt;10.20.20.30&lt;br&gt;&lt;i&gt;DNS primario con DNSSEC, PAC y hora con NTS&lt;/i&gt;" celeris_id="SVC01" celeris_tipo="componente" ip="10.20.20.30" zona="SERVERS" criticidad="Alta" estado="diseño" por_que="Sin DNS ni PAC no funcionan ni el proxy ni DIRECT; por eso hay un segundo resolvedor (FW01) y una copia del PAC en EDGE01." aporta="Unbound con validación DNSSEC (F2), PAC en http://pac.celeris.internal/wpad.dat (F3), chrony con NTS hacia arriba (F25)." si_falla="Los clientes resuelven con FW01 y obtienen el PAC de EDGE01; la navegación continúa (T22). Pérdida solo de NTS y de DNSSEC primario." flujos="F2, F3, F13, F17, F25" pruebas="T09, T11, T18, T22" placeholders="1" tooltip="SVC01 · Alta&#10;Por qué: Sin DNS ni PAC no funcionan ni el proxy ni DIRECT; por eso hay un segundo resolvedor (FW01) y una copia del PAC en EDGE01.&#10;Aporta: Unbound con validación DNSSEC (F2), PAC en http://pac.celeris.internal/wpad.dat (F3), chrony con NTS hacia arriba (F25).&#10;Si falla: Los clientes resuelven con FW01 y obtienen el PAC de EDGE01; la navegación continúa (T22). Pérdida solo de NTS y de DNSSEC primario.">
          <mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#009E73;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=32;spacingTop=1;spacingRight=2;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
            <mxGeometry x="850" y="610" width="180" height="84" as="geometry" />
