        <object id="FIG-5.1-11" label="&lt;b&gt;VLAN 40 · DMZ-SVC&lt;/b&gt; · 10.20.40.0/24 · confianza Baja" celeris_id="DMZ-SVC" celeris_tipo="zona" cidr="10.20.40.0/24" vlan="40" gateway="10.20.40.1" confianza="Baja" proposito="Servicios publicados: WAF01 y WEB01 (portal de transparencia)" tooltip="DMZ-SVC: Servicios publicados: WAF01 y WEB01 (portal de transparencia). Regla: No inicia hacia ninguna zona interna">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F9E8DB;strokeColor=#D55E00;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=11;fontColor=#1A1A1A;" parent="1" vertex="1">
