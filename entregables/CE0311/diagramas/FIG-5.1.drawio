        <object id="FIG-5.1-62" label="&lt;b&gt;VTI1&lt;/b&gt; · Interfaz del túnel 1 (activo) · &lt;b&gt;ALTA&lt;/b&gt;&lt;br&gt;169.254.10.0/30" celeris_id="VTI1" celeris_tipo="componente" ip="169.254.10.0/30" zona="PERIMETRO" criticidad="Alta" estado="diseño" por_que="Interfaz VTI route-based de FW01: permite que BGP aprenda 10.30.0.0/16 y que el túnel activo lleve el tráfico híbrido." aporta="Red interna 169.254.10.0/30, MTU 1400, MSS clamping 1360, IKEv2 con AES-256-GCM-16; AWS asigna o se fijan las direcciones /30 (se registran en el inventario)." si_falla="El tráfico híbrido cambia al túnel 2 en ≤ 60 s medidos (T05, OD-05)." flujos="" pruebas="T01, T02, T05, T21" placeholders="1" tooltip="VTI1 · Alta&#10;Por qué: Interfaz VTI route-based de FW01: permite que BGP aprenda 10.30.0.0/16 y que el túnel activo lleve el tráfico híbrido.&#10;Aporta: Red interna 169.254.10.0/30, MTU 1400, MSS clamping 1360, IKEv2 con AES-256-GCM-16; AWS asigna o se fijan las direcciones /30 (se registran en el inventario).&#10;Si falla: El tráfico híbrido cambia al túnel 2 en ≤ 60 s medidos (T05, OD-05).">
          <mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=32;spacingTop=1;spacingRight=2;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
