        <object id="FIG-5.2-2" label="&lt;b&gt;Internet&lt;/b&gt;&lt;br&gt;ISP · IP pública 203.0.113.10" celeris_id="INTERNET" celeris_tipo="zona" confianza="Nula" proposito="Internet pública: ISP, orígenes web, ACME, feeds y S3 (bucket celeris-backups)" tooltip="INTERNET: Internet pública: ISP, orígenes web, ACME, feeds y S3 (bucket celeris-backups). Regla: Entrada solo 443 (y 80 → redirección) hacia PORTAL01 por NAT 1:1 en el FortiGate y 443 hacia EC2-GW; señuelos en ventana autorizada">
          <mxCell style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#4D4D4D;fontSize=11;fontColor=#1A1A1A;" parent="1" vertex="1">
