        <object id="FIG-5.2-85" label="&lt;b&gt;Tablas de rutas de la VPC&lt;/b&gt;&lt;br&gt;&lt;b&gt;rt-public&lt;/b&gt; (AWS-PUB-A): 0.0.0.0/0 → Internet Gateway; 10.20.0.0/16 (SEDE-JULIACA) → VGW (propagada por BGP)&lt;br&gt;&lt;b&gt;rt-private&lt;/b&gt; (AWS-APP-A): 10.20.0.0/16 (SEDE-JULIACA) → VGW (propagada por BGP); prefijo de S3 → Gateway Endpoint de S3 (sin costo por hora); 0.0.0.0/0 → NAT-DR (solo en el simulacro)&lt;br&gt;Reservado: 10.30.128.0/17 (Reservado en la VPC: Kubernetes / crecimiento (D2.5))" celeris_rol="tablas_rutas" celeris_ref="AWS-VPC">
