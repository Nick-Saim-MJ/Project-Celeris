        <object id="FIG-5.2-5" label="&lt;b&gt;TRANSITO&lt;/b&gt; · 10.20.0.0/29 · confianza Media&lt;br&gt;GW 10.20.0.1 (FGT-EXT) · 6 hosts útiles&lt;br&gt;FW01 10.20.0.2" celeris_id="TRANSITO" celeris_tipo="zona" cidr="10.20.0.0/29" gateway="10.20.0.1" confianza="Media" proposito="Red de tránsito FW01 ↔ FortiGate: FortiGate 10.20.0.1, FW01 10.20.0.2 [S-29]" tooltip="TRANSITO: Red de tránsito FW01 ↔ FortiGate: FortiGate 10.20.0.1, FW01 10.20.0.2 [S-29]. Regla: El FortiGate hace NAT 1:1 hacia 10.20.0.2 solo para UDP 500/4500 (IPsec con NAT-T) y TCP 80/443 (portal)">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F1F1;strokeColor=#999999;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=11;fontColor=#1A1A1A;" parent="1" vertex="1">
