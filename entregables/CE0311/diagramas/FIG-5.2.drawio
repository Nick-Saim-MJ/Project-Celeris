        <object id="FIG-5.2-263" label="&lt;b&gt;Ruteo&lt;/b&gt;&lt;br&gt;0.0.0.0/0 → ISP por la WAN 203.0.113.10 (salto del ISP no definido: CI-30)&lt;br&gt;10.30.0.0/16 → AWS por BGP (VTI1 activo, VTI2 respaldo) · ASN 65020 ↔ 64512&lt;br&gt;FW01 anuncia 10.20.0.0/16 (futuro 10.20.0.0/14; CI-31)&lt;br&gt;Entre VLAN: FW01 router-on-a-stick, deny-all con registro&lt;br&gt;VLAN 70 10.20.70.0/24: sin gateway, no enrutada" celeris_rol="ruteo" celeris_ref="FW01">
          <mxCell style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
