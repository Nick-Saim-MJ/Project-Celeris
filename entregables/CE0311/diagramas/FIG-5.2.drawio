        <object id="FIG-5.2-12" label="&lt;b&gt;WIFI-EST&lt;/b&gt; · 172.16.0.0/16 · confianza Muy baja · &lt;i&gt;red de la DTI, fuera de FW01&lt;/i&gt;&lt;br&gt;Entra por FGT-EXT; FW01 solo recibe F31 y F32" celeris_id="WIFI-EST" celeris_tipo="zona" cidr="172.16.0.0/16" confianza="Muy baja" proposito="Wi-Fi de estudiantes (BYOD): red de la DTI que FW01 no enruta; valor provisional 172.16.0.0/16" tooltip="WIFI-EST: Wi-Fi de estudiantes (BYOD): red de la DTI que FW01 no enruta; valor provisional 172.16.0.0/16. Regla: Solo EDGE (sin descifrado, F31) y portal (F32); nunca llega a CTRL01, MGMT ni LAB; el nodo nunca descifra esta red (REQ-F-36)">
          <mxCell style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FBF8D0;strokeColor=#F0E442;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=11;fontColor=#1A1A1A;" parent="1" vertex="1">
