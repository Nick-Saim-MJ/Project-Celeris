        <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#4D4D4D;strokeWidth=1.5;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;" parent="1" edge="1" source="FIG-5.2-33" target="FIG-5.2-15" id="FIG-5.2-36" value="VLAN 40 · .1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="FIG-5.2-37" label="&lt;b&gt;VLAN 41 · DMZ-HONEY&lt;/b&gt; · 10.20.41.0/24 · confianza Nula&lt;br&gt;GW 10.20.41.1 · 254 hosts" celeris_id="DMZ-HONEY" celeris_tipo="zona" cidr="10.20.41.0/24" vlan="41" gateway="10.20.41.1" confianza="Nula" proposito="Señuelos expuestos (HNY01)" tooltip="DMZ-HONEY: Señuelos expuestos (HNY01). Regla: Solo envía al SIEM; nada más">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8ECF3;strokeColor=#CC79A7;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=11;fontColor=#1A1A1A;" parent="1" vertex="1">
            <mxGeometry x="780" y="300" width="178" height="130" as="geometry" />
