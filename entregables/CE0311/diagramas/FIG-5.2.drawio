        <object id="FIG-5.2-72" label="&lt;b&gt;NAS01&lt;/b&gt; · Almacenamiento y respaldos (TrueNAS) · &lt;b&gt;MEDIA&lt;/b&gt;&lt;br&gt;10.20.70.20 (almacenamiento)" celeris_id="NAS01" celeris_tipo="componente" ip="almacenamiento 10.20.70.20 · respaldo 10.20.71.20 · gestion 10.20.10.30" zona="STORAGE, BACKUP, MGMT" criticidad="Media" estado="diseño" por_que="Concentra el datastore NFS de ESX01 (VLAN 70, sin ruteo) y el destino de respaldos 3-2-1-1-0 (VLAN 71, enrutada con lista de permitidos); además actúa como servidor NUT." aporta="2× 4 TB RAID 1; NFS 4.1 en TCP 2049 solo desde ESX01 vmk1 (F19); SFTP en TCP 22 desde DB01, CTRL01, SVC01 y OBS01 (F17); copia a S3 (F18)." si_falla="Se pierde el datastore NFS y el destino local de respaldos; las VM del datastore de VM no se afectan. Mitigación: copia fuera del sitio en S3 con Object Lock 30 días (D2.9)." flujos="F13, F17, F18, F19, F20" pruebas="T11, T12, T18, T30, T31, T34, T39, T40, T41, T45, T46, T47, T48" placeholders="1" tooltip="NAS01 · Media&#10;Por qué: Concentra el datastore NFS de ESX01 (VLAN 70, sin ruteo) y el destino de respaldos 3-2-1-1-0 (VLAN 71, enrutada con lista de permitidos); además actúa como servidor NUT.&#10;Aporta: 2× 4 TB RAID 1; NFS 4.1 en TCP 2049 solo desde ESX01 vmk1 (F19); SFTP en TCP 22 desde DB01, CTRL01, SVC01 y OBS01 (F17); copia a S3 (F18).&#10;Si falla: Se pierde el datastore NFS y el destino local de respaldos; las VM del datastore de VM no se afectan. Mitigación: copia fuera del sitio en S3 con Object Lock 30 días (D2.9).">
          <mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=32;spacingTop=1;spacingRight=2;fontSize=9;fontColor=#1A1A1A;" parent="1" vertex="1">
            <mxGeometry x="1234" y="568" width="158" height="56" as="geometry" />
