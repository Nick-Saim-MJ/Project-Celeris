        <object id="FIG-5.2-208" label="«F…»: varios flujos (ver Anexo A) · —: intra-zona o no aplica · F2 (DNS y NTP hacia FW01) no se repite" celeris_rol="nota">
          <mxCell style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=9;fontColor=#1A1A1A;" parent="1" vertex="1">
            <mxGeometry x="620" y="1154" width="612" height="34" as="geometry" />
          </mxCell>
        </object>
        <object id="FIG-5.2-209" label="&lt;b&gt;Ruteo&lt;/b&gt;&lt;br&gt;FW01: 0.0.0.0/0 → FGT-EXT 10.20.0.1 (red de tránsito 10.20.0.0/29)&lt;br&gt;FW01: 10.30.0.0/16 → AWS por BGP (VTI1 activo, VTI2 respaldo) · ASN 65020 ↔ 64512&lt;br&gt;FW01 anuncia 10.20.0.0/16 (futuro 10.20.0.0/14)&lt;br&gt;Entre VLAN: FW01 con una subinterfaz .1 por VLAN; deny-all con registro&lt;br&gt;FGT-EXT: necesita una ruta estática a 10.20.0.0/16 vía 10.20.0.2" celeris_rol="ruteo" celeris_ref="FW01">
          <mxCell style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
            <mxGeometry x="1250" y="860" width="510" height="96" as="geometry" />
          </mxCell>
        </object>
        <object id="FIG-5.2-210" label="&lt;b&gt;Servicios base&lt;/b&gt; (D-28)&lt;br&gt;DHCP: Pools y reservas por rango de laboratorio (FW01 o el DHCP de la DTI [S-14]); DHCP snooping, DAI, port-security&lt;br&gt;DNS: FW01 (Unbound, DNSSEC) en la interfaz .1 de cada VLAN; hacia arriba DoT (TCP 853, F25)&lt;br&gt;NTP: FW01 (NTP de OPNsense); clientes NTP UDP 123 (F2); hacia arriba NTS (TCP 4460 + UDP 123, F25)&lt;br&gt;PAC: http://pac.celeris.internal/wpad.dat → EDGE01 10.20.60.10, EDGE02 10.20.60.11&lt;br&gt;IPv6: Deshabilitado en LAB (RA guard, DHCPv6 guard)&lt;br&gt;DNS cifrado: TCP/UDP 853 bloqueado desde LAB; DoH limitado por GPO&lt;br&gt;Wi-Fi: DNS y DHCP de la DTI" celeris_rol="servicios_base">
          <mxCell style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
            <mxGeometry x="1250" y="966" width="510" height="166" as="geometry" />
          </mxCell>
        </object>
