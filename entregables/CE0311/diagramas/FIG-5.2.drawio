        <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#4D4D4D;strokeWidth=1.5;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;" parent="1" edge="1" source="FIG-5.2-17" target="FIG-5.2-15" id="FIG-5.2-28" value="VLAN 10 · .1">
