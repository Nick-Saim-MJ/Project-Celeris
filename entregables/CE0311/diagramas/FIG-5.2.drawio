        <object id="FIG-5.2-67" label="&lt;b&gt;EDGE02&lt;/b&gt; · Nodo Celeris 2 · &lt;b&gt;ALTA&lt;/b&gt;&lt;br&gt;10.20.60.11" celeris_id="EDGE02" celeris_tipo="componente" ip="10.20.60.11" zona="EDGE" criticidad="Alta" estado="diseño" por_que="Segunda ruta de salida del PAC: cumple la meta de ≥ 3 rutas por usuario (EDGE01, EDGE02, DIRECT) y cubre el mantenimiento de EDGE01." aporta="Misma función y puertos que EDGE01 (F1, F8, F9, F10, F11), con su propio datastore NVMe de caché; se despliega en la fase F2." si_falla="El PAC usa EDGE01; con ambos caídos, DIRECT (T09)." flujos="F1, F13" pruebas="T07, T09, T11, T13, T14, T18, T22, T30, T31, T44, T47" placeholders="1" tooltip="EDGE02 · Alta&#10;Por qué: Segunda ruta de salida del PAC: cumple la meta de ≥ 3 rutas por usuario (EDGE01, EDGE02, DIRECT) y cubre el mantenimiento de EDGE01.&#10;Aporta: Misma función y puertos que EDGE01 (F1, F8, F9, F10, F11), con su propio datastore NVMe de caché; se despliega en la fase F2.&#10;Si falla: El PAC usa EDGE01; con ambos caídos, DIRECT (T09).">
          <mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=32;spacingTop=1;spacingRight=2;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
