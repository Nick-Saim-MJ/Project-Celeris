        </object>
        <object id="FIG-5.2-38" label="&lt;b&gt;HNY01&lt;/b&gt; · Honeypot OpenCanary + Cowrie · &lt;b&gt;MEDIA&lt;/b&gt;&lt;br&gt;10.20.41.20" celeris_id="HNY01" celeris_tipo="componente" ip="10.20.41.20" zona="DMZ-HONEY" criticidad="Media" estado="diseño" por_que="Un honeypot está hecho para ser comprometido: vive en su propia VLAN 41 (D-16) y solo envía eventos al SIEM." aporta="Cowrie y OpenCanary reciben TCP 22→2222 y 23 por DNAT (F24, solo con aprobación escrita de la DTI y en ventana definida); envía eventos a SIEM01 (F13)." si_falla="Se pierde la detección de fuerza bruta por señuelo SSH/Telnet (F24, DET-04); DMZ-SVC y el resto de la red no se afectan porque HNY01 (10.20.41.20) vive en DMZ-HONEY." flujos="F13, F24" pruebas="T03, T05, T10, T11, T15, T18, T19, T20, T30, T31, T34, T47, T58" placeholders="1" tooltip="HNY01 · Media&#10;Por qué: Un honeypot está hecho para ser comprometido: vive en su propia VLAN 41 (D-16) y solo envía eventos al SIEM.&#10;Aporta: Cowrie y OpenCanary reciben TCP 22→2222 y 23 por DNAT (F24, solo con aprobación escrita de la DTI y en ventana definida); envía eventos a SIEM01 (F13).&#10;Si falla: Se pierde la detección de fuerza bruta por señuelo SSH/Telnet (F24, DET-04); DMZ-SVC y el resto de la red no se afectan porque HNY01 (10.20.41.20) vive en DMZ-HONEY.">
          <mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CC79A7;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=32;spacingTop=1;spacingRight=2;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
            <mxGeometry x="790" y="362" width="158" height="56" as="geometry" />
          </mxCell>
        </object>
        <mxCell style="shape=mxgraph.networks.secured;fillColor=#CCCCCC;strokeColor=#4D4D4D;html=1;aspect=fixed;outlineConnect=0;dashed=0;" parent="1" vertex="1" id="FIG-5.2-39" value="">
          <mxGeometry x="795" y="368" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#4D4D4D;strokeWidth=1.5;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;" parent="1" edge="1" source="FIG-5.2-37" target="FIG-5.2-15" id="FIG-5.2-40" value="VLAN 41 · .1">
          <mxGeometry relative="1" as="geometry" />
