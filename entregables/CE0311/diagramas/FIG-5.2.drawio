        <object id="FIG-5.2-64" label="&lt;b&gt;VLAN 60 · EDGE&lt;/b&gt; · 10.20.60.0/24 · confianza Media&lt;br&gt;GW 10.20.60.1 · 254 hosts útiles" celeris_id="EDGE" celeris_tipo="zona" cidr="10.20.60.0/24" vlan="60" gateway="10.20.60.1" confianza="Media" proposito="Nodos Celeris" tooltip="EDGE: Nodos Celeris. Regla: Solo recibe 3128 desde LAB; sale a Internet y al shield">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#4D4D4D;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=11;fontColor=#1A1A1A;" parent="1" vertex="1">
