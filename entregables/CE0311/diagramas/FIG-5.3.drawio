        <object id="FIG-5.3-49" label="&lt;b&gt;VLAN 60 · EDGE&lt;/b&gt; · 10.20.60.0/24 · confianza &lt;b&gt;Media&lt;/b&gt;&lt;br&gt;&lt;i&gt;Recibe 3128 y 80 de LAB y de WIFI-EST (esta sin descifrar); sale a Internet (F8) y a CTRL01 (F10)&lt;/i&gt;" celeris_id="EDGE" celeris_tipo="zona" cidr="10.20.60.0/24" confianza="Media" tooltip="EDGE: Nodos Celeris. Regla: Recibe 3128 y 80 de LAB y de WIFI-EST (esta sin descifrar); sale a Internet (F8) y a CTRL01 (F10)">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#4D4D4D;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=6;spacingTop=1;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
