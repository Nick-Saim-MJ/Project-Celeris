        <object id="FIG-5.3-59" label="&lt;b&gt;VLAN 20 · SERVERS&lt;/b&gt; · 10.20.20.0/24 · confianza &lt;b&gt;Alta&lt;/b&gt;&lt;br&gt;&lt;i&gt;No inicia hacia usuarios&lt;/i&gt;" celeris_id="SERVERS" celeris_tipo="zona" cidr="10.20.20.0/24" confianza="Alta" tooltip="SERVERS: Consola del encargado (CTRL01: SPA, API y PostgreSQL local, sin red) y CA interna. Regla: No inicia hacia usuarios">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DBF1EB;strokeColor=#009E73;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=6;spacingTop=1;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
            <mxGeometry x="422" y="850" width="380" height="182" as="geometry" />
