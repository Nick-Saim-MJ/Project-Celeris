        <object id="FIG-5.3-58" label="&lt;b&gt;VLAN 50 · SECURITY&lt;/b&gt; · 10.20.50.0/24 · confianza &lt;b&gt;Alta&lt;/b&gt;&lt;br&gt;&lt;i&gt;Recibe de todos, no inicia hacia ninguno salvo NTP/DNS y feeds&lt;/i&gt;" celeris_id="SECURITY" celeris_tipo="zona" cidr="10.20.50.0/24" confianza="Alta" tooltip="SECURITY: Wazuh, sensor Suricata. Regla: Recibe de todos, no inicia hacia ninguno salvo NTP/DNS y feeds">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E7F4FC;strokeColor=#56B4E9;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=6;spacingTop=1;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
