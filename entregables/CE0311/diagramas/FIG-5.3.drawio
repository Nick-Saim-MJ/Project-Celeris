        <object id="FIG-5.3-71" label="&lt;b&gt;SW-CORE01&lt;/b&gt; · Switch núcleo L2 · &lt;b&gt;ALTA&lt;/b&gt;&lt;br&gt;10.20.10.2" celeris_id="SW-CORE01" celeris_tipo="componente" ip="10.20.10.2" zona="MGMT" criticidad="Alta" estado="diseño" por_que="FW01 enruta (router-on-a-stick) y SW-CORE01 solo conmuta: necesita 802.1Q con lista explícita de VLAN y el puerto break-glass rotulado." aporta="24× 1 GbE + 2–4× SFP+ 10 GbE; trunks con VLAN permitidas explícitas, nativa 999, puertos sin uso apagados; incluye el puerto de emergencia en VLAN 10." si_falla="Cae la conectividad física de ESX01 y la capa de acceso. Mitigación: configuración en Git; el servicio de los laboratorios depende de su reemplazo (no hay segundo switch en el diseño)." flujos="F20" pruebas="T06, T23, T25, T27, T34, T54" placeholders="1" tooltip="SW-CORE01 · Alta&#10;Por qué: FW01 enruta (router-on-a-stick) y SW-CORE01 solo conmuta: necesita 802.1Q con lista explícita de VLAN y el puerto break-glass rotulado.&#10;Aporta: 24× 1 GbE + 2–4× SFP+ 10 GbE; trunks con VLAN permitidas explícitas, nativa 999, puertos sin uso apagados; incluye el puerto de emergencia en VLAN 10.&#10;Si falla: Cae la conectividad física de ESX01 y la capa de acceso. Mitigación: configuración en Git; el servicio de los laboratorios depende de su reemplazo (no hay segundo switch en el diseño).">
          <mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0072B2;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=32;spacingTop=1;spacingRight=2;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
            <mxGeometry x="220" y="1114" width="180" height="64" as="geometry" />
          </mxCell>
        </object>
        <mxCell style="shape=mxgraph.networks.switch;fillColor=#CCCCCC;strokeColor=#4D4D4D;html=1;aspect=fixed;outlineConnect=0;dashed=0;" parent="1" vertex="1" id="FIG-5.3-72" value="">
          <mxGeometry x="225" y="1120" width="22" height="22" as="geometry" />
        </mxCell>
        <object id="FIG-5.3-73" label="&lt;b&gt;BRK01&lt;/b&gt; · Puerto break-glass · &lt;b&gt;MEDIA&lt;/b&gt;&lt;br&gt;10.20.10.250" celeris_id="BRK01" celeris_tipo="componente" ip="10.20.10.250" zona="MGMT" criticidad="Media" estado="diseño" por_que="Si FW01 cae no hay ruteo entre VLAN; el puerto rotulado en VLAN 10 permite llegar a ESXi, IPMI y DCUI para restaurar FW01 desde su XML en Git." aporta="Puerto de acceso de SW-CORE01 en VLAN 10, desactivado administrativamente y activado desde la consola del switch; la laptop usa 10.20.10.250." si_falla="Si el puerto no funciona, la recuperación de FW01 requiere acceso físico al servidor (iDRAC/iLO sin red). Mitigación: probado en T25." flujos="" pruebas="T25" placeholders="1" tooltip="BRK01 · Media&#10;Por qué: Si FW01 cae no hay ruteo entre VLAN; el puerto rotulado en VLAN 10 permite llegar a ESXi, IPMI y DCUI para restaurar FW01 desde su XML en Git.&#10;Aporta: Puerto de acceso de SW-CORE01 en VLAN 10, desactivado administrativamente y activado desde la consola del switch; la laptop usa 10.20.10.250.&#10;Si falla: Si el puerto no funciona, la recuperación de FW01 requiere acceso físico al servidor (iDRAC/iLO sin red). Mitigación: probado en T25.">
          <mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0072B2;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=32;spacingTop=1;spacingRight=2;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
            <mxGeometry x="410" y="1114" width="180" height="64" as="geometry" />
          </mxCell>
        </object>
