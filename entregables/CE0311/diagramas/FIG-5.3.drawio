        <object id="FIG-5.3-36" label="&lt;b&gt;PCS-LAB&lt;/b&gt; · PCs de laboratorio (grupo) · &lt;b&gt;ALTA&lt;/b&gt; · &lt;i&gt;existente&lt;/i&gt;&lt;br&gt;LAB-01…LAB-10: 10 rangos /26 · DHCP con reservas" celeris_id="PCS-LAB" celeris_tipo="componente" ip="LAB-01…LAB-10: 10 rangos /26 · DHCP con reservas" zona="LAB" criticidad="Alta" estado="existente" por_que="Son los usuarios del servicio: 10 laboratorios de 40 PCs [S-26], cuyas descargas repetidas el diseño mantiene dentro de la LAN." aporta="Cada laboratorio tiene un rango /26 (rangos_lab, LAB-01 a LAB-10) con reservas DHCP; usan el PAC por GPO (F3), el proxy en TCP 3128 (F1), el portal (F5) y, solo en el piloto, DIRECT (F6); el encargado habilita o deshabilita cada rango (REQ-F-32)." si_falla="Un laboratorio sin conectividad no afecta a los demás; la capa de acceso existente está fuera de alcance [S-14]." flujos="" pruebas="" placeholders="1" tooltip="PCS-LAB · Alta&#10;Por qué: Son los usuarios del servicio: 10 laboratorios de 40 PCs [S-26], cuyas descargas repetidas el diseño mantiene dentro de la LAN.&#10;Aporta: Cada laboratorio tiene un rango /26 (rangos_lab, LAB-01 a LAB-10) con reservas DHCP; usan el PAC por GPO (F3), el proxy en TCP 3128 (F1), el portal (F5) y, solo en el piloto, DIRECT (F6); el encargado habilita o deshabilita cada rango (REQ-F-32).&#10;Si falla: Un laboratorio sin conectividad no afecta a los demás; la capa de acceso existente está fuera de alcance [S-14].">
          <mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E69F00;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=32;spacingTop=1;spacingRight=2;fontSize=9;fontColor=#1A1A1A;dashed=1;dashPattern=6 3;" parent="1" vertex="1">
            <mxGeometry x="30" y="734" width="180" height="64" as="geometry" />
          </mxCell>
        </object>
        <mxCell style="shape=mxgraph.networks.pc;fillColor=#FFFFFF;strokeColor=#4D4D4D;dashed=1;html=1;aspect=fixed;outlineConnect=0;dashed=0;" parent="1" vertex="1" id="FIG-5.3-37" value="">
          <mxGeometry x="35" y="740" width="22" height="22" as="geometry" />
