        <object id="FIG-5.3-30" label="&lt;b&gt;VLAN 40 · DMZ-SVC&lt;/b&gt; · 10.20.40.0/24 · confianza &lt;b&gt;Baja&lt;/b&gt; (expuesta)&lt;br&gt;&lt;i&gt;No inicia hacia ninguna zona interna&lt;/i&gt;" celeris_id="DMZ-SVC" celeris_tipo="zona" cidr="10.20.40.0/24" confianza="Baja" tooltip="DMZ-SVC: Servicio publicado: PORTAL01 (WAF + portal de transparencia estático). Regla: No inicia hacia ninguna zona interna">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F9E8DB;strokeColor=#D55E00;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=6;spacingTop=1;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
