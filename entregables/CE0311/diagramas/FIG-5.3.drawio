        <object id="FIG-5.3-9" label="&lt;b&gt;PERIMETRO&lt;/b&gt; · confianza &lt;b&gt;Media&lt;/b&gt; · Anti-spoofing: bloqueo de redes privadas y bogons entrantes&lt;br&gt;&lt;i&gt;Red de tránsito FW01 ↔ FortiGate: FortiGate 10.20.0.1, FW01 10.20.0.2 [S-29]&lt;/i&gt;" celeris_id="PERIMETRO" celeris_tipo="zona" confianza="Media">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#1A1A1A;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=6;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
