        <object id="FIG-5.4-28" label="&lt;b&gt;AWS-APP-B&lt;/b&gt; · 10.30.11.0/24 · AZ b · &lt;b&gt;MEDIA&lt;/b&gt;" celeris_id="AWS-APP-B" celeris_tipo="componente" ip="10.30.11.0/24" zona="AWS" criticidad="Media" estado="diseño" por_que="Aloja EC2-CTRLR sin exposición directa a Internet." aporta="Mismas rutas que app-a (rt-private)." si_falla="Se pierde la réplica (ver EC2-CTRLR)." flujos="" pruebas="" placeholders="1" tooltip="AWS-APP-B · Media&#10;Por qué: Aloja EC2-CTRLR sin exposición directa a Internet.&#10;Aporta: Mismas rutas que app-a (rt-private).&#10;Si falla: Se pierde la réplica (ver EC2-CTRLR).">
