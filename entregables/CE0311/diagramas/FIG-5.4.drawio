        <object id="FIG-5.4-36" label="F29 · TCP/443 · TLS" celeris_id="F29" celeris_tipo="flujo" etiqueta="F29 · TCP/443 · TLS" proposito="Panel remoto" proteccion="TLS 1.3 con certificado público, HSTS, WAF (Coraza) y segundo factor" riesgo_residual="Medio: expuesto a Internet en AWS (no en el campus); lo compensan Coraza, el límite de intentos y el segundo factor; un EC2-GW comprometido solo alcanza CTRL01:443 con mTLS y SIEM01 (AM-18)" regla_fw="F29 INTERNET &gt; EC2-GW panel-remoto tcp/443 (sg-gw)" tooltip="F29 · TCP/443 · TLS&#10;Panel remoto&#10;TLS 1.3 con certificado público, HSTS, WAF (Coraza) y segundo factor">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;fontColor=#1A1A1A;jumpStyle=gap;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" edge="1" source="FIG-5.4-20" target="FIG-5.4-28">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
        <object id="FIG-5.4-37" label="F30 · TCP/443 · mTLS en IPsec" celeris_id="F30" celeris_tipo="flujo" etiqueta="F30 · TCP/443 · mTLS en IPsec" proposito="Panel remoto hacia la consola" proteccion="mTLS (certificado de cliente de EC2-GW) dentro de IPsec" riesgo_residual="Bajo: solo CTRL01:443 con certificado de cliente; la consola marca la sesión como `remoto` y rechaza las acciones críticas (REQ-F-37, T54)" regla_fw="F30 EC2-GW &gt; CTRL01 consola-remota tcp/443 via VTI" tooltip="F30 · TCP/443 · mTLS en IPsec&#10;Panel remoto hacia la consola&#10;mTLS (certificado de cliente de EC2-GW) dentro de IPsec">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;fontColor=#1A1A1A;jumpStyle=gap;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.3;exitY=1;entryX=0.5;entryY=1;" parent="1" edge="1" source="FIG-5.4-28" target="FIG-5.4-14">
