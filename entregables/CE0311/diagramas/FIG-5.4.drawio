        <object id="FIG-5.4-30" label="&lt;b&gt;Security Group sg-gw&lt;/b&gt;&lt;br&gt;entrada TCP/443 desde 0.0.0.0/0 (F29)&lt;br&gt;salida TCP/443 hacia CTRL01 (F30)&lt;br&gt;salida TCP/1514,1515 hacia SIEM01 (F13)&lt;br&gt;salida TCP/443 hacia 0.0.0.0/0 (ACME y actualizaciones)" celeris_rol="sg" celeris_ref="EC2-GW">
          <mxCell style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
