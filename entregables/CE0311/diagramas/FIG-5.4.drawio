        <object id="FIG-5.4-13" label="&lt;b&gt;Extremo on-premise&lt;/b&gt;: FW01 OPNsense (IPsec route-based con interfaces VTI, strongSwan), detrás del FortiGate FGT-EXT&lt;br&gt;IP pública 203.0.113.10 en FGT-EXT: Documentación RFC 5737 [S-15]; NAT 1:1 en el FortiGate hacia 10.20.0.2 (UDP 500/4500) [S-29]&lt;br&gt;NAT-T: UDP 4500, porque FW01 está detrás de NAT; el NAT-T agrega 8 bytes y el margen del MSS alcanza" celeris_rol="extremo" celeris_ref="FW01">
          <mxCell style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
            <mxGeometry x="30" y="350" width="560" height="110" as="geometry" />
          </mxCell>
        </object>
        <object id="FIG-5.4-14" label="&lt;b&gt;VLAN 20 · SERVERS&lt;/b&gt; · 10.20.20.0/24 · confianza Alta&lt;br&gt;CTRL01 10.20.20.10: destino de F30" celeris_id="SERVERS" celeris_tipo="zona" cidr="10.20.20.0/24" vlan="20" gateway="10.20.20.1" confianza="Alta" proposito="Consola del encargado (CTRL01: SPA, API y PostgreSQL local, sin red) y CA interna" tooltip="SERVERS: Consola del encargado (CTRL01: SPA, API y PostgreSQL local, sin red) y CA interna. Regla: No inicia hacia usuarios">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DBF1EB;strokeColor=#009E73;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=11;fontColor=#1A1A1A;" parent="1" vertex="1">
            <mxGeometry x="30" y="476" width="270" height="100" as="geometry" />
