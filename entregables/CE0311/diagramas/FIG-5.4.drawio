        <object id="FIG-5.4-38" label="F13 · TCP/1514,1515 · cifrado Wazuh (AES)" celeris_id="F13" celeris_tipo="flujo" etiqueta="F13 · TCP/1514,1515 · cifrado Wazuh (AES)" proposito="Agentes Wazuh" proteccion="Cifrado AES del protocolo Wazuh; enrolamiento con verificación del manager; desde EC2-GW, además dentro de IPsec" riesgo_residual="Bajo: el enrolamiento depende de la verificación del manager" regla_fw="F13 AGENTES &gt; SIEM01 wazuh tcp/1514,1515" tooltip="F13 · TCP/1514,1515 · cifrado Wazuh (AES)&#10;Agentes Wazuh&#10;Cifrado AES del protocolo Wazuh; enrolamiento con verificación del manager; desde EC2-GW, además dentro de IPsec">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;labelBackgroundColor=#FFFFFF;strokeColor=#1A1A1A;fontColor=#1A1A1A;jumpStyle=gap;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.7;exitY=1;entryX=0.5;entryY=1;" parent="1" edge="1" source="FIG-5.4-28" target="FIG-5.4-15">
