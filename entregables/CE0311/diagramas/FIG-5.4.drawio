          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#1A1A1A;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=6;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
