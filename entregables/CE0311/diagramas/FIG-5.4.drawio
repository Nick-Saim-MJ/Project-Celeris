        <object id="FIG-5.4-70" label="&lt;b&gt;Qué aporta y qué pasa si falla&lt;/b&gt;&lt;br&gt;&lt;b&gt;FGT-EXT&lt;/b&gt; — FortiGate existente: IP pública, NAT 1:1 y FortiGuard. &lt;i&gt;Si falla:&lt;/i&gt; Todo el campus sin Internet y FW01 (10.20.0.2) sin salida a…&lt;br&gt;&lt;b&gt;FW01&lt;/b&gt; — Ruteo entre zonas, deny-all, IPS, VPN, DNS y NTP. &lt;i&gt;Si falla:&lt;/i&gt; Se pierde el ruteo entre VLAN, la salida a Internet, la VPN y…&lt;br&gt;&lt;b&gt;VTI1&lt;/b&gt; — Túnel IPsec activo con BGP hacia el VGW. &lt;i&gt;Si falla:&lt;/i&gt; El tráfico híbrido cambia al túnel 2 en ≤ 60 s medidos (T05…&lt;br&gt;&lt;b&gt;VTI2&lt;/b&gt; — Túnel IPsec de respaldo con AS-path prepending. &lt;i&gt;Si falla:&lt;/i&gt; Se pierde la redundancia (OD-05)&lt;br&gt;&lt;b&gt;VGW&lt;/b&gt; — Extremo AWS de la VPN con BGP. &lt;i&gt;Si falla:&lt;/i&gt; Se pierde la conectividad híbrida&lt;br&gt;&lt;b&gt;AWS-VPC&lt;/b&gt; — Aislamiento de los recursos del proyecto en AWS. &lt;i&gt;Si falla:&lt;/i&gt; Se pierden los recursos de AWS&lt;br&gt;&lt;b&gt;AWS-PUB-A&lt;/b&gt; — Aloja EC2-GW, el proxy inverso del panel remoto. &lt;i&gt;Si falla:&lt;/i&gt; Se pierde el acceso remoto al panel (ver EC2-GW)&lt;br&gt;&lt;b&gt;AWS-APP-A&lt;/b&gt; — Vacía; aloja la EC2 temporal del simulacro. &lt;i&gt;Si falla:&lt;/i&gt; Sin efecto en operación normal&lt;br&gt;&lt;b&gt;EC2-GW&lt;/b&gt; — Panel remoto sin exponer ningún puerto del campus. &lt;i&gt;Si falla:&lt;/i&gt; Solo se pierde el acceso remoto" celeris_rol="panel" componentes="FGT-EXT, FW01, VTI1, VTI2, VGW, AWS-VPC, AWS-PUB-A, AWS-APP-A, EC2-GW">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#4D4D4D;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=9;fontColor=#1A1A1A;" parent="1" vertex="1">
            <mxGeometry x="1700" y="10" width="490" height="234" as="geometry" />
          </mxCell>
        </object>
