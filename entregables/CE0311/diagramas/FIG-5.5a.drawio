        <object id="FIG-5.5a-19" label="&lt;b&gt;VLAN 30 · LAB&lt;/b&gt; · 10.20.32.0/22 &lt;i&gt;(toda la zona)&lt;/i&gt;" celeris_id="LAB" celeris_tipo="zona" cidr="10.20.32.0/22" confianza="Baja" tooltip="LAB: PCs de los 10 laboratorios (un rango /26 cada uno) e infraestructura de laboratorio (ENC01, LABCLI01, KALI01, HNY02); detalle en rangos_lab">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCF2DB;strokeColor=#E69F00;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
