        <object id="FIG-5.5a-15" label="&lt;b&gt;WIFI-EST&lt;/b&gt; · 172.16.0.0/16 &lt;i&gt;(toda la zona)&lt;/i&gt;" celeris_id="WIFI-EST" celeris_tipo="zona" cidr="172.16.0.0/16" confianza="Muy baja" tooltip="WIFI-EST: Wi-Fi de estudiantes (BYOD): red de la DTI que FW01 no enruta; valor provisional 172.16.0.0/16">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDFBE5;strokeColor=#F0E442;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
