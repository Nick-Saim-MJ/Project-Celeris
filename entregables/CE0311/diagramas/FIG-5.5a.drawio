          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#4D4D4D;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
