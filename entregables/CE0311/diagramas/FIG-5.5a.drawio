        <object id="FIG-5.5a-11" label="&lt;b&gt;VLAN 40 · DMZ-SVC&lt;/b&gt; · 10.20.40.0/24 &lt;i&gt;(toda la zona)&lt;/i&gt;" celeris_id="DMZ-SVC" celeris_tipo="zona" cidr="10.20.40.0/24" confianza="Baja" tooltip="DMZ-SVC: Servicios publicados: WAF01 y WEB01 (portal de transparencia)">
