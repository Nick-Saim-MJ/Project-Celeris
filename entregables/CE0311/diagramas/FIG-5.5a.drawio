        <object id="FIG-5.5a-7" label="&lt;b&gt;VLAN 41 · DMZ-HONEY&lt;/b&gt; · 10.20.41.0/24 &lt;i&gt;(toda la zona)&lt;/i&gt;" celeris_id="DMZ-HONEY" celeris_tipo="zona" cidr="10.20.41.0/24" confianza="Nula" tooltip="DMZ-HONEY: Señuelos expuestos (HNY01)">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8ECF3;strokeColor=#CC79A7;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
