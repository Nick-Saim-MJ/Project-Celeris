        <object id="FIG-5.5a-11" label="&lt;b&gt;VLAN 40 · DMZ-SVC&lt;/b&gt; · 10.20.40.0/24 &lt;i&gt;(toda la zona)&lt;/i&gt;" celeris_id="DMZ-SVC" celeris_tipo="zona" cidr="10.20.40.0/24" confianza="Baja" tooltip="DMZ-SVC: Servicio publicado: PORTAL01 (WAF + portal de transparencia estático)">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F9E8DB;strokeColor=#D55E00;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
            <mxGeometry x="20" y="370" width="1628" height="64" as="geometry" />
