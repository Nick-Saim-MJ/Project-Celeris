        <mxCell style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=none;opacity=55;" parent="1" vertex="1" id="FIG-5.5a-4" value="">
          <mxGeometry x="24" y="266" width="1620" height="30" as="geometry" />
