        <object id="FIG-5.5b-45" label="&lt;b&gt;JMP01&lt;/b&gt; · Jump host de administración · &lt;b&gt;MEDIA&lt;/b&gt; · 10.20.10.20" celeris_id="JMP01" celeris_tipo="componente" ip="10.20.10.20" zona="MGMT" criticidad="Media" estado="diseño" por_que="Es el único origen de conexiones administrativas hacia cualquier zona (F20) y de la GUI de OPNsense; concentra el MFA y el registro de acceso." aporta="SSH con llave y MFA; interfaces web por HTTPS (3000 Grafana, 5601 Wazuh, 9128 administración de Celeris); despliega el sitio de PORTAL01 por SSH y es el servidor NUT." si_falla="No hay administración remota de la plataforma. Mitigación: BRK01 para ESXi/IPMI/FW01; configuración en Git." flujos="F20, F27" pruebas="T27, T34, T35, T54" placeholders="1" tooltip="JMP01 · Media&#10;Por qué: Es el único origen de conexiones administrativas hacia cualquier zona (F20) y de la GUI de OPNsense; concentra el MFA y el registro de acceso.&#10;Aporta: SSH con llave y MFA; interfaces web por HTTPS (3000 Grafana, 5601 Wazuh, 9128 administración de Celeris); despliega el sitio de PORTAL01 por SSH y es el servidor NUT.&#10;Si falla: No hay administración remota de la plataforma. Mitigación: BRK01 para ESXi/IPMI/FW01; configuración en Git.">
          <mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0072B2;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=28;spacingTop=1;spacingRight=2;fontSize=9;fontColor=#1A1A1A;" parent="1" vertex="1">
            <mxGeometry x="36" y="962" width="340" height="26" as="geometry" />
          </mxCell>
        </object>
        <mxCell style="shape=mxgraph.networks.server;fillColor=#CCCCCC;strokeColor=#4D4D4D;html=1;aspect=fixed;outlineConnect=0;dashed=0;" parent="1" vertex="1" id="FIG-5.5b-46" value="">
          <mxGeometry x="41" y="966" width="18" height="18" as="geometry" />
        </mxCell>
        <object id="FIG-5.5b-47" label="&lt;b&gt;SW-CORE01&lt;/b&gt; · Switch núcleo L2 · &lt;b&gt;ALTA&lt;/b&gt; · 10.20.10.2" celeris_id="SW-CORE01" celeris_tipo="componente" ip="10.20.10.2" zona="MGMT" criticidad="Alta" estado="diseño" por_que="FW01 enruta (router-on-a-stick) y SW-CORE01 solo conmuta: necesita 802.1Q con lista explícita de VLAN y el puerto break-glass rotulado." aporta="24× 1 GbE + 2–4× SFP+ 10 GbE; trunks con VLAN permitidas explícitas, nativa 999, puertos sin uso apagados; incluye el puerto de emergencia en VLAN 10." si_falla="Cae la conectividad física de ESX01 y la capa de acceso. Mitigación: configuración en Git; el servicio de los laboratorios depende de su reemplazo (no hay segundo switch en el diseño)." flujos="F20" pruebas="T06, T23, T25, T27, T34, T54" placeholders="1" tooltip="SW-CORE01 · Alta&#10;Por qué: FW01 enruta (router-on-a-stick) y SW-CORE01 solo conmuta: necesita 802.1Q con lista explícita de VLAN y el puerto break-glass rotulado.&#10;Aporta: 24× 1 GbE + 2–4× SFP+ 10 GbE; trunks con VLAN permitidas explícitas, nativa 999, puertos sin uso apagados; incluye el puerto de emergencia en VLAN 10.&#10;Si falla: Cae la conectividad física de ESX01 y la capa de acceso. Mitigación: configuración en Git; el servicio de los laboratorios depende de su reemplazo (no hay segundo switch en el diseño).">
          <mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0072B2;strokeWidth=3;align=left;verticalAlign=middle;spacingLeft=28;spacingTop=1;spacingRight=2;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
            <mxGeometry x="36" y="992" width="340" height="26" as="geometry" />
          </mxCell>
        </object>
        <mxCell style="shape=mxgraph.networks.switch;fillColor=#CCCCCC;strokeColor=#4D4D4D;html=1;aspect=fixed;outlineConnect=0;dashed=0;" parent="1" vertex="1" id="FIG-5.5b-48" value="">
          <mxGeometry x="41" y="996" width="18" height="18" as="geometry" />
