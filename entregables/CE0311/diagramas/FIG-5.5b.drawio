        <object id="FIG-5.5b-57" label="&lt;b&gt;AWS&lt;/b&gt; · 10.30.0.0/16 &lt;i&gt;(toda la zona)&lt;/i&gt;" celeris_id="AWS" celeris_tipo="zona" cidr="10.30.0.0/16" confianza="Baja" tooltip="AWS: VPC celeris (10.30.0.0/16): EC2-GW (panel remoto), S3 de respaldos y subred privada vacía para el simulacro de recuperación">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF5E6;strokeColor=#232F3E;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
