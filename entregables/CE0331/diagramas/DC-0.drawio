        <object id="DC-0-3" label="&lt;b&gt;On-premise · Campus Juliaca&lt;/b&gt; · un rack de 12U · ESXi gratuito, un host" celeris_rol="campus">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#1A1A1A;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#1A1A1A;" parent="1" vertex="1">
