        <object id="DC-1-9" label="&lt;b&gt;RACK01&lt;/b&gt; · Rack de 12U · &lt;b&gt;ALTA&lt;/b&gt; · 12U: U1–U3, U6–U7 y U10–U12 asignadas; U4–U5 y U8–U9 libres · U12 arriba · el alto de cada fila no es a escala" celeris_id="RACK01" celeris_tipo="elemento" tipo="Rack" entorno="On-premise" criticidad="Alta" funcion="Aloja y alimenta los equipos del centro de datos" recursos="12U: U1–U3, U6–U7 y U10–U12 asignadas; U4–U5 y U8–U9 libres" por_que="Un solo rack de 12U alcanza para un host de 2U, un switch, la UPS y la distribución; mantiene el cableado corto y el acceso físico controlado." si_falla="Un incidente físico en el rack (incendio, inundación, robo) detiene todo el servicio; la copia en S3 con Object Lock es lo que sobrevive (D2.9).">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#1A1A1A;strokeWidth=3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=3;fontSize=11;fontColor=#1A1A1A;" parent="1" vertex="1">
