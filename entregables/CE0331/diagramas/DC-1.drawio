        <object id="DC-1-33" label="&lt;b&gt;Energía:&lt;/b&gt; consumo ≈ 480 W; autonomía 15–20 min (a confirmar con el fabricante (d2.4)). &lt;b&gt;NUT:&lt;/b&gt; Lee UPS01 y apaga por SSH las VM y luego ESXi (F20); intrazona de MGMT, no cruza FW01.&lt;br&gt;&lt;b&gt;Arranque:&lt;/b&gt; FW01 → CTRL01 → EDGE01/02 → SIEM01 → resto (D2.4)." celeris_rol="energia" celeris_ref="UPS01">
          <mxCell style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
