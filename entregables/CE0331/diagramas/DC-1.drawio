        <object id="DC-1-32" label="&lt;b&gt;CD-PDU01&lt;/b&gt; · PDU · &lt;b&gt;ALTA&lt;/b&gt;&lt;br&gt;En U1–3 junto a UPS01&lt;br&gt;&lt;i&gt;Reparte la UPS a ESX01 y SW-CORE01&lt;/i&gt;" celeris_id="CD-PDU01" celeris_tipo="elemento" tipo="Energía" entorno="On-premise" criticidad="Alta" funcion="Distribuye la salida de la UPS a ESX01 y SW-CORE01" recursos="En U1–3 junto a UPS01" por_que="Reparte la energía de la UPS a los dos equipos sin cadenas de regletas." si_falla="ESX01 y SW-CORE01 pierden energía aunque la UPS funcione; se reemplaza la PDU o se conecta cada equipo directo a la UPS." tooltip="CD-PDU01 · Alta&#10;Función: Distribuye la salida de la UPS a ESX01 y SW-CORE01&#10;Por qué: Reparte la energía de la UPS a los dos equipos sin cadenas de regletas.&#10;Si falla: ESX01 y SW-CORE01 pierden energía aunque la UPS funcione; se reemplaza la PDU o se conecta cada equipo directo a la UPS.">
          <mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=2;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
