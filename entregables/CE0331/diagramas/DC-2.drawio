        <object id="DC-2-11" label="&lt;b&gt;HNY02&lt;/b&gt; · Canary interno · &lt;b&gt;MEDIA&lt;/b&gt;&lt;br&gt;1 vCPU · 1 GB · 10 GB · Debian 13 · F1&lt;br&gt;&lt;i&gt;Detecta escaneos dentro de la VLAN de laboratorio&lt;/i&gt;" celeris_id="HNY02" celeris_tipo="componente" ip="10.20.35.250" zona="LAB" criticidad="Media" estado="diseño" por_que="El firewall no ve el tráfico dentro de una misma VLAN; este canary detecta cualquier escaneo dentro de LAB." aporta="OpenCanary en 10.20.35.250; cualquier contacto genera un evento hacia SIEM01 (F13, única excepción de LAB hacia SECURITY)." si_falla="Se pierde la detección de movimiento lateral PC a PC en LAB." flujos="F13" pruebas="T05, T11, T18, T19, T30, T31, T47, T58" placeholders="1" tooltip="HNY02 · Media&#10;Por qué: El firewall no ve el tráfico dentro de una misma VLAN; este canary detecta cualquier escaneo dentro de LAB.&#10;Aporta: OpenCanary en 10.20.35.250; cualquier contacto genera un evento hacia SIEM01 (F13, única excepción de LAB hacia SECURITY).&#10;Si falla: Se pierde la detección de movimiento lateral PC a PC en LAB.">
          <mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E69F00;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=32;spacingTop=2;spacingRight=2;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
