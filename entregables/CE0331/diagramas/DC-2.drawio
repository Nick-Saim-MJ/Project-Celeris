        <object id="DC-2-23" label="&lt;b&gt;PG-SEC&lt;/b&gt; · Port group · &lt;b&gt;ALTA&lt;/b&gt;&lt;br&gt;VLAN 50 · zona SECURITY · vSwitch0&lt;br&gt;&lt;i&gt;VM: SIEM01&lt;/i&gt;" celeris_id="PG-SEC" celeris_tipo="elemento" tipo="Red virtual (port group)" entorno="On-premise" criticidad="Alta" funcion="VLAN 50 · zona SECURITY" recursos="vSwitch0 · VLAN 50 · VM: SIEM01" por_que="Una VLAN por port group mantiene la zona SECURITY aislada de las demás dentro del mismo vSwitch." si_falla="Las VM conectadas (SIEM01) pierden red; el resto de port groups no se afecta." tooltip="PG-SEC · Alta&#10;Función: VLAN 50 · zona SECURITY&#10;Por qué: Una VLAN por port group mantiene la zona SECURITY aislada de las demás dentro del mismo vSwitch.&#10;Si falla: Las VM conectadas (SIEM01) pierden red; el resto de port groups no se afecta.">
          <mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#56B4E9;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=2;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
            <mxGeometry x="280" y="576" width="300" height="78" as="geometry" />
