        <object id="DC-2-7" label="&lt;b&gt;PG-SERVERS&lt;/b&gt; · Port group · &lt;b&gt;ALTA&lt;/b&gt;&lt;br&gt;VLAN 20 · zona SERVERS · vSwitch0&lt;br&gt;&lt;i&gt;VM: CTRL01&lt;/i&gt;" celeris_id="PG-SERVERS" celeris_tipo="elemento" tipo="Red virtual (port group)" entorno="On-premise" criticidad="Alta" funcion="VLAN 20 · zona SERVERS" recursos="vSwitch0 · VLAN 20 · VM: CTRL01" por_que="Una VLAN por port group mantiene la zona SERVERS aislada de las demás dentro del mismo vSwitch." si_falla="Las VM conectadas (CTRL01) pierden red; el resto de port groups no se afecta." tooltip="PG-SERVERS · Alta&#10;Función: VLAN 20 · zona SERVERS&#10;Por qué: Una VLAN por port group mantiene la zona SERVERS aislada de las demás dentro del mismo vSwitch.&#10;Si falla: Las VM conectadas (CTRL01) pierden red; el resto de port groups no se afecta.">
          <mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#009E73;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=2;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
            <mxGeometry x="280" y="232" width="300" height="78" as="geometry" />
