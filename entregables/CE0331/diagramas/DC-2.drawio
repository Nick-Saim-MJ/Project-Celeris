          <mxGeometry x="605" y="582" width="22" height="22" as="geometry" />
        </mxCell>
        <object id="DC-2-26" label="&lt;b&gt;PG-EDGE&lt;/b&gt; · Port group · &lt;b&gt;ALTA&lt;/b&gt;&lt;br&gt;VLAN 60 · zona EDGE · vSwitch0&lt;br&gt;&lt;i&gt;VM: EDGE01, EDGE02&lt;/i&gt;" celeris_id="PG-EDGE" celeris_tipo="elemento" tipo="Red virtual (port group)" entorno="On-premise" criticidad="Alta" funcion="VLAN 60 · zona EDGE" recursos="vSwitch0 · VLAN 60 · VM: EDGE01, EDGE02" por_que="Una VLAN por port group mantiene la zona EDGE aislada de las demás dentro del mismo vSwitch." si_falla="Las VM conectadas (EDGE01, EDGE02) pierden red; el resto de port groups no se afecta." tooltip="PG-EDGE · Alta&#10;Función: VLAN 60 · zona EDGE&#10;Por qué: Una VLAN por port group mantiene la zona EDGE aislada de las demás dentro del mismo vSwitch.&#10;Si falla: Las VM conectadas (EDGE01, EDGE02) pierden red; el resto de port groups no se afecta.">
          <mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=2;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
            <mxGeometry x="280" y="662" width="300" height="78" as="geometry" />
