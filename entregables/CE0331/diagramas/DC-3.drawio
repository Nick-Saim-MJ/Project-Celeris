        <object id="DC-3-59" label="&lt;b&gt;Qué aporta y qué pasa si falla&lt;/b&gt;&lt;br&gt;&lt;b&gt;AWS-VPC&lt;/b&gt; — Aislamiento de los recursos del proyecto en AWS. &lt;i&gt;Si falla:&lt;/i&gt; Se pierden los recursos de AWS&lt;br&gt;&lt;b&gt;IGW01&lt;/b&gt; — Salida y entrada de Internet de la subred pública. &lt;i&gt;Si falla:&lt;/i&gt; EC2-GW queda sin tráfico de Internet: se pierde el acceso remoto&lt;br&gt;&lt;b&gt;VGW&lt;/b&gt; — Extremo AWS de la VPN con BGP. &lt;i&gt;Si falla:&lt;/i&gt; Se pierde la conectividad híbrida&lt;br&gt;&lt;b&gt;AWS-PUB-A&lt;/b&gt; — Aloja EC2-GW, el proxy inverso del panel remoto. &lt;i&gt;Si falla:&lt;/i&gt; Se pierde el acceso remoto al panel (ver EC2-GW)&lt;br&gt;&lt;b&gt;EC2-GW&lt;/b&gt; — Panel remoto sin exponer ningún puerto del campus. &lt;i&gt;Si falla:&lt;/i&gt; Solo se pierde el acceso remoto&lt;br&gt;&lt;b&gt;NAT-DR&lt;/b&gt; — NAT solo durante el simulacro de recuperación. &lt;i&gt;Si falla:&lt;/i&gt; Sin efecto en operación normal&lt;br&gt;&lt;b&gt;sg-gw&lt;/b&gt; — Firewall con estado de EC2-GW. &lt;i&gt;Si falla:&lt;/i&gt; Si se abre de más, EC2-GW queda más expuesta&lt;br&gt;&lt;b&gt;nacl-public&lt;/b&gt; — Filtro sin estado de la subred AWS-PUB-A. &lt;i&gt;Si falla:&lt;/i&gt; Queda solo el Security Group como filtro" celeris_rol="panel" componentes="AWS-VPC, IGW01, VGW, AWS-PUB-A, EC2-GW, NAT-DR, sg-gw, nacl-public, rt-public, AWS-APP-A, EC2-DR, sg-dr, nacl-private, VPCE-S3, rt-private, S3">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#4D4D4D;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=9;fontColor=#1A1A1A;" parent="1" vertex="1">
            <mxGeometry x="1840.0" y="318" width="265.0" height="270" as="geometry" />
          </mxCell>
        </object>
        <object id="DC-3-60" label="&lt;b&gt;…continúa&lt;/b&gt;&lt;br&gt;&lt;b&gt;rt-public&lt;/b&gt; — 0.0.0.0/0 → IGW01. &lt;i&gt;Si falla:&lt;/i&gt; Sin la ruta correcta la subred pierde su destino&lt;br&gt;&lt;b&gt;AWS-APP-A&lt;/b&gt; — Vacía; aloja la EC2 temporal del simulacro. &lt;i&gt;Si falla:&lt;/i&gt; Sin efecto en operación normal&lt;br&gt;&lt;b&gt;EC2-DR&lt;/b&gt; — Restaura la consola desde S3 durante el simulacro. &lt;i&gt;Si falla:&lt;/i&gt; Sin efecto en operación normal&lt;br&gt;&lt;b&gt;sg-dr&lt;/b&gt; — Firewall con estado de EC2-DR. &lt;i&gt;Si falla:&lt;/i&gt; Sin efecto en operación normal (existe solo en el simulacro)&lt;br&gt;&lt;b&gt;nacl-private&lt;/b&gt; — Filtro sin estado de la subred AWS-APP-A. &lt;i&gt;Si falla:&lt;/i&gt; Queda solo el Security Group como filtro&lt;br&gt;&lt;b&gt;VPCE-S3&lt;/b&gt; — Acceso privado a S3 desde la subred privada. &lt;i&gt;Si falla:&lt;/i&gt; Sin efecto en operación normal&lt;br&gt;&lt;b&gt;rt-private&lt;/b&gt; — 10.20.0.0/16 → VGW. &lt;i&gt;Si falla:&lt;/i&gt; Sin la ruta correcta la subred pierde su destino&lt;br&gt;&lt;b&gt;S3&lt;/b&gt; — Copia fuera del sitio inmutable por 30 días. &lt;i&gt;Si falla:&lt;/i&gt; Se pierde la copia externa" celeris_rol="panel" componentes="AWS-VPC, IGW01, VGW, AWS-PUB-A, EC2-GW, NAT-DR, sg-gw, nacl-public, rt-public, AWS-APP-A, EC2-DR, sg-dr, nacl-private, VPCE-S3, rt-private, S3">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#4D4D4D;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=9;fontColor=#1A1A1A;" parent="1" vertex="1">
            <mxGeometry x="2115.0" y="318" width="265.0" height="246" as="geometry" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
