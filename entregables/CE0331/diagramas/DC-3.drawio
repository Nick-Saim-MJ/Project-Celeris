        <object id="DC-3-10" label="&lt;b&gt;AWS-PUB-A&lt;/b&gt; · 10.30.0.0/24 · AZ a · &lt;b&gt;MEDIA&lt;/b&gt;" celeris_id="AWS-PUB-A" celeris_tipo="componente" ip="10.30.0.0/24" zona="AWS" criticidad="Media" estado="diseño" por_que="Aloja EC2-GW; es la única subred con ruta al Internet Gateway." aporta="rt-public: 0.0.0.0/0 → Internet Gateway y 10.20.0.0/16 → VGW (propagada por BGP); EC2-GW en 10.30.0.10 y, solo durante el simulacro, NAT-DR." si_falla="Se pierde el acceso remoto al panel (ver EC2-GW)." flujos="" pruebas="" placeholders="1" tooltip="AWS-PUB-A · Media&#10;Por qué: Aloja EC2-GW; es la única subred con ruta al Internet Gateway.&#10;Aporta: rt-public: 0.0.0.0/0 → Internet Gateway y 10.20.0.0/16 → VGW (propagada por BGP); EC2-GW en 10.30.0.10 y, solo durante el simulacro, NAT-DR.&#10;Si falla: Se pierde el acceso remoto al panel (ver EC2-GW).">
          <mxCell style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#7AA116;fillColor=#F2F6E8;strokeWidth=2;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=30;fontSize=10;fontColor=#232F3E;container=0;dashed=0;" parent="1" vertex="1">
            <mxGeometry x="600" y="230" width="820" height="320" as="geometry" />
          </mxCell>
        </object>
        <object id="DC-3-11" label="&lt;b&gt;EC2-GW&lt;/b&gt; · Proxy inverso del panel remoto · &lt;b&gt;MEDIA&lt;/b&gt;&lt;br&gt;t3.micro · 2 vCPU · 1 GiB · 8 GB gp3 · 10.30.0.10&lt;br&gt;&lt;i&gt;Panel remoto sin exponer ningún puerto del campus&lt;/i&gt;" celeris_id="EC2-GW" celeris_tipo="componente" ip="10.30.0.10" zona="AWS" criticidad="Media" estado="diseño" por_que="Permite al encargado usar la consola desde fuera del campus sin publicar ningún puerto del campus: termina TLS, aplica el WAF y reenvía solo la consola a CTRL01:443 por la VPN. No guarda datos ni llaves de firma." aporta="Caddy con certificado público (ACME), TLS 1.3, HSTS, Coraza (OWASP CRS) y límite de intentos; recibe TCP 443 de Internet (F29) y reenvía solo a CTRL01:443 por IPsec con su certificado de cliente (mTLS, F30); su salida está limitada a CTRL01:443, SIEM01:1514/1515 (F13) y TCP 443 a Internet (ACME y actualizaciones). t3.micro con 8 GB gp3 en pub-a." si_falla="Solo se pierde el acceso remoto; la consola local sigue (ENC01). Si se compromete, se destruye y se recrea con OpenTofu en 15 min." flujos="F13, F29, F30" pruebas="T01, T02, T03, T05, T11, T18, T19, T21, T27, T30, T31, T47, T53, T54, T58" placeholders="1" tooltip="EC2-GW · Media&#10;Por qué: Permite al encargado usar la consola desde fuera del campus sin publicar ningún puerto del campus: termina TLS, aplica el WAF y reenvía solo la consola a CTRL01:443 por la VPN. No guarda datos ni llaves de firma.&#10;Aporta: Caddy con certificado público (ACME), TLS 1.3, HSTS, Coraza (OWASP CRS) y límite de intentos; recibe TCP 443 de Internet (F29) y reenvía solo a CTRL01:443 por IPsec con su certificado de cliente (mTLS, F30); su salida está limitada a CTRL01:443, SIEM01:1514/1515 (F13) y TCP 443 a Internet (ACME y actualizaciones). t3.micro con 8 GB gp3 en pub-a.&#10;Si falla: Solo se pierde el acceso remoto; la consola local sigue (ENC01). Si se compromete, se destruye y se recrea con OpenTofu en 15 min.">
          <mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=32;spacingTop=2;spacingRight=2;fontSize=10;fontColor=#1A1A1A;" parent="1" vertex="1">
            <mxGeometry x="620" y="270" width="330" height="110" as="geometry" />
          </mxCell>
        </object>
        <mxCell style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;fillColor=#ED7100;strokeColor=#FFFFFF;html=1;aspect=fixed;outlineConnect=0;dashed=0;" parent="1" vertex="1" id="DC-3-12" value="">
          <mxGeometry x="625" y="276" width="22" height="22" as="geometry" />
        </mxCell>
        <object id="DC-3-13" label="&lt;b&gt;NAT-DR&lt;/b&gt; · Instancia NAT temporal del simulacro · &lt;b&gt;BAJA&lt;/b&gt; · &lt;i&gt;temporal&lt;/i&gt;&lt;br&gt;t3.micro · solo en el simulacro T59&lt;br&gt;&lt;i&gt;NAT solo durante el simulacro de recuperación&lt;/i&gt;" celeris_id="NAT-DR" celeris_tipo="componente" ip="Temporal: IP privada de pub-a asignada al crearla" zona="AWS" criticidad="Baja" estado="temporal" por_que="Permite que EC2-DR instale paquetes durante el simulacro y demuestra NAT (rúbrica de S2) sin una instancia NAT 24×7." aporta="t3.micro en pub-a; rt-private apunta a ella 0.0.0.0/0 solo durante el simulacro (sg-dr); lleva la etiqueta Ttl y se destruye al terminar T59." si_falla="Sin efecto en operación normal; EC2-DR no puede instalar paquetes durante el simulacro." flujos="" pruebas="T59" placeholders="1" tooltip="NAT-DR · Baja&#10;Por qué: Permite que EC2-DR instale paquetes durante el simulacro y demuestra NAT (rúbrica de S2) sin una instancia NAT 24×7.&#10;Aporta: t3.micro en pub-a; rt-private apunta a ella 0.0.0.0/0 solo durante el simulacro (sg-dr); lleva la etiqueta Ttl y se destruye al terminar T59.&#10;Si falla: Sin efecto en operación normal; EC2-DR no puede instalar paquetes durante el simulacro.">
          <mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=32;spacingTop=2;spacingRight=2;fontSize=10;fontColor=#1A1A1A;dashed=1;dashPattern=3 3;" parent="1" vertex="1">
            <mxGeometry x="620" y="400" width="330" height="90" as="geometry" />
          </mxCell>
