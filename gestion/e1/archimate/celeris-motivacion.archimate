  <folder name="Motivation" id="id-d965472439b6433b8d6ebcdc224b9195" type="motivation">
    <element xsi:type="archimate:Driver" name="Costo y saturación del enlace" id="id-dr1"/>
    <element xsi:type="archimate:Driver" name="Calidad de la enseñanza en laboratorios" id="id-dr2"/>
    <element xsi:type="archimate:Driver" name="Ley 29733 y su reglamento" id="id-dr3"/>
    <element xsi:type="archimate:Assessment" name="La misma descarga se repite en 40 PCs" id="id-as1"/>
    <element xsi:type="archimate:Assessment" name="El contenido HTTPS no se reutiliza" id="id-as2"/>
    <element xsi:type="archimate:Assessment" name="El encargado no puede decidir ni medir" id="id-as3"/>
    <element xsi:type="archimate:Assessment" name="Descifrar exige aviso previo" id="id-as4"/>
    <element xsi:type="archimate:Goal" name="OE-a Fortalecer la infraestructura tecnológica para la enseñanza" id="id-OE-a"/>
    <element xsi:type="archimate:Goal" name="OE-b Calidad académica: laboratorios listos para cada clase" id="id-OE-b"/>
    <element xsi:type="archimate:Goal" name="OE-c Gestión eficiente de los recursos" id="id-OE-c"/>
    <element xsi:type="archimate:Goal" name="OE-d Seguridad de la información y cumplimiento" id="id-OE-d"/>
    <element xsi:type="archimate:Outcome" name="OB-1 Ahorro de Internet: BHR ≥ 25 %" id="id-OB-1"/>
    <element xsi:type="archimate:Outcome" name="OB-2 Ahorro de tiempo: −70 %" id="id-OB-2"/>
    <element xsi:type="archimate:Outcome" name="OB-3 Autonomía del encargado: ≤ 5 min" id="id-OB-3"/>
    <element xsi:type="archimate:Outcome" name="OB-4 Transparencia: 100 %" id="id-OB-4"/>
    <element xsi:type="archimate:Outcome" name="OB-5 Seguridad del servicio: ≥ 90 % en S2" id="id-OB-5"/>
    <element xsi:type="archimate:Requirement" name="REQ-F-03 Cachear lo compartible (RFC 9111)" id="id-REQ-F-03"/>
    <element xsi:type="archimate:Requirement" name="REQ-F-05 Coalescer peticiones al mismo objeto" id="id-REQ-F-05"/>
    <element xsi:type="archimate:Requirement" name="REQ-F-25 Reportar el ahorro por laboratorio" id="id-REQ-F-25"/>
    <element xsi:type="archimate:Requirement" name="REQ-F-34 Programar una precarga" id="id-REQ-F-34"/>
    <element xsi:type="archimate:Requirement" name="REQ-F-31 Gestionar el catálogo de contenido" id="id-REQ-F-31"/>
    <element xsi:type="archimate:Requirement" name="REQ-F-32 Gestionar el acceso por laboratorio" id="id-REQ-F-32"/>
    <element xsi:type="archimate:Requirement" name="REQ-F-12 Publicar la página de transparencia" id="id-REQ-F-12"/>
    <element xsi:type="archimate:Requirement" name="REQ-F-14 Enviar eventos de seguridad al SIEM" id="id-REQ-F-14"/>
  </folder>
