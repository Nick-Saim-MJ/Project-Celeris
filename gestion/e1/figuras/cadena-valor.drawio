<mxfile host="Celeris CE01"><diagram id="d1" name="cadena-valor"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;ACTIVIDADES DE APOYO&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Calibri;fontSize=13;fontColor=#003865;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="300" height="24" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Infraestructura de TI y soporte&lt;/b&gt; — DEPENDENCIA DE LOS LABORATORIOS: ALTA&lt;br&gt;Prepara y mantiene los laboratorios estación por estación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8A800;strokeColor=#F8A800;strokeWidth=3;fontColor=#262626;fontFamily=Calibri;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="900" height="66" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Gestión administrativa y financiera&lt;/b&gt; — DEPENDENCIA DE LOS LABORATORIOS: BAJA&lt;br&gt;Paga el enlace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE5EF;strokeColor=#2F5D8A;strokeWidth=1;fontColor=#262626;fontFamily=Calibri;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="118" width="900" height="66" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;ACTIVIDADES PRIMARIAS&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Calibri;fontSize=13;fontColor=#003865;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="210" width="300" height="24" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Enseñanza en laboratorios&lt;/b&gt;&lt;br&gt;DEPENDENCIA: ALTA&lt;br&gt;&lt;br&gt;Software de cada curso, actualizaciones y plataforma virtual se descargan en las PCs del laboratorio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8A800;strokeColor=#F8A800;strokeWidth=3;fontColor