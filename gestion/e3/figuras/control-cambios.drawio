<mxfile host="Celeris CE01"><diagram id="d1" name="control-cambios"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;1. Solicitud&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Cualquier interesado abre un issue con la etiqueta cambio-alcance y el formato del anexo A&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#003865;strokeWidth=2;fontColor=#262626;fontFamily=Calibri;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="200" height="130" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;2. Análisis de impacto&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;El director modifica una copia de plan.yaml y ejecuta plan.py: efecto en la ruta crítica, en H1–H4, en el BAC y en los riesgos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#003865;strokeWidth=2;fontColor=#262626;fontFamily=Calibri;fontSize=12;" vertex="1" parent="1"><mxGeometry x="236" y="0" width="200" height="130" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;3. Decisión&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Director y líder técnico si el cambio cabe en la contingencia y no mueve H1 ni H4; si no, el sponsor&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#003865;strokeColor=#003865;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Calibri;fontSize=12;" vertex="1" parent="1"><mxGeometry x="472" y="0" width="200" height="130" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;4. Registro&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Se fusiona el cambio en plan.yaml con su CI-xx en CAMBIOS-INVENTARIO.md; la línea base nueva queda en el XML de MS Project&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#003865;strokeWidth=2;fontColor=#262626;fontFamily=Calibri;fontSize=12;" vertex="1" parent="1"><mxGeometry x="708" y="0" width="200" height="130" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;5. Comunicación&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Se informa en el seguimiento semanal y se cierra el issue con el enlace al commit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#003865;strokeWidth=2;fontColor=#262626;fontFamily=Calibri;fontSize=12;" vertex="1" parent="1"><mxGeometry x="944" y="0" width="200" height="130" as="geometry"/></mxCell><mxCell id="c6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#003865;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#003865;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#003865;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#003865;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Quién aprueba según el impacto&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Calibri;fontSize=12;fontColor=#003865;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="352" y="160" width="440" height="22" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Líder técnico&lt;/b&gt;: Dentro de un paquete, sin efecto en la ruta crítica ni en el BAC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8FA9C4;strokeWidth=1;fontColor=#262626;fontFamily=Calibri;fontSize=12;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="352" y="190" width="440" height="52" as="geometry"/></mxCell><mxCell id="c12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#7F7F7F;strokeWidth=1.2;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c3" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Director del proyecto&lt;/b&gt;: Consume contingencia o mueve un hito intermedio (H2, H3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE5EF;strokeColor=#2F5D8A;strokeWidth=2;fontColor=#262626;fontFamily=Calibri;fontSize=12;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="352" y="252" width="440" height="52" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Sponsor&lt;/b&gt;: Mueve H1 o H4, agrega o retira un paquete de la EDT o requiere reserva de gestión" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCD98A;strokeColor=#F8A800;strokeWidth=3;fontColor=#262626;fontFamily=Calibri;fontSize=12;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="352" y="314" width="440" height="52" as="geometry"/></mxCell><mxCell id="c15" value="Rechazada: se cierra el issue con el motivo. Aprobada: nueva línea base en plan.yaml y en el XML de MS Project." style="text;html=1;whiteSpace=wrap;fontFamily=Calibri;fontSize=11;fontColor=#262626;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="390" width="1150" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
