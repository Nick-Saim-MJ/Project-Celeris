      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fin_di" bpmnElement="fin" bioc:fill="#FFFFFF" bioc:stroke="#003865" color:background-color="#FFFFFF" color:border-color="#003865">
        <dc:Bounds x="1742" y="602" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1700" y="642" width="120" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flujo_1_di" bpmnElement="Flujo_1">
        <di:waypoint x="198" y="216"/>
        <di:waypoint x="278" y="216"/>
      </bpmndi:BPMNEdge>
