        <dc:Bounds x="1542" y="1086" width="120" height="72"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c5_di" bpmnElement="c5" bioc:fill="#FFFFFF" bioc:stroke="#003865" color:background-color="#FFFFFF" color:border-color="#003865">
        <dc:Bounds x="1226" y="936" width="120" height="72"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c6_di" bpmnElement="c6" bioc:fill="#FCD98A" bioc:stroke="#F8A800" color:background-color="#FCD98A" color:border-color="#F8A800">
        <dc:Bounds x="1384" y="382" width="120" height="72"/>
      </bpmndi:BPMNShape>
