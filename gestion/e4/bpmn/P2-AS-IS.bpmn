<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Def_P2_AS_IS" targetNamespace="https://celeris.test/ce01/e4/P2-AS-IS" exporter="Celeris gestion/e4/bpmn.py" exporterVersion="0.1">
  <bpmn:collaboration id="Colaboracion_P2_AS_IS">
    <bpmn:participant id="Participante_Campus" name="UPeU Campus Juliaca" processRef="Proceso_P2_AS_IS"/>
    <bpmn:participant id="Participante_Internet" name="Internet / ISP"/>
    <bpmn:messageFlow id="Mensaje_1" name="Descarga" sourceRef="b5" targetRef="Participante_Internet"/>
  </bpmn:collaboration>
  <bpmn:process id="Proceso_P2_AS_IS" name="P2 Preparación de un laboratorio para una clase (AS-IS)" isExecutable="false">
    <bpmn:laneSet id="Carriles">
      <bpmn:lane id="Carril_docente" name="Docente">
        <bpmn:flowNodeRef>ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_encargado" name="Encargado de laboratorio">
        <bpmn:flowNodeRef>b2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_tecnico" name="Técnico DTI Soporte">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_pc" name="PC del laboratorio">
        <bpmn:flowNodeRef>b5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ini" name="El docente necesita software o material">
      <bpmn:outgoing>Flujo_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="b1" name="Avisar el pedido por mensaje o en persona">
      <bpmn:documentation>Duración triangular 0,050 / 0,100 / 0,250 h [S-43]. Recurso: Docente</bpmn:documentation>
      <bpmn:incoming>Flujo_1</bpmn:incoming>
      <bpmn:outgoing>Flujo_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g0" name="¿Llega con un día de anticipación?">
      <bpmn:incoming>Flujo_2</bpmn:incoming>
      <bpmn:outgoing>Flujo_3</bpmn:outgoing>
      <bpmn:outgoing>Flujo_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="b2" name="Revisar el pedido">
      <bpmn:documentation>Duración triangular 0,100 / 0,250 / 0,500 h [S-43]. Recurso: Encargado de laboratorio</bpmn:documentation>
      <bpmn:incoming>Flujo_3</bpmn:incoming>
      <bpmn:incoming>Flujo_4</bpmn:incoming>
      <bpmn:outgoing>Flujo_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="¿Requiere una fuente nueva o un cambio de acceso?">
      <bpmn:incoming>Flujo_5</bpmn:incoming>
      <bpmn:outgoing>Flujo_6</bpmn:outgoing>
      <bpmn:outgoing>Flujo_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="b3" name="Solicitar el cambio a la DTI">
      <bpmn:documentation>Duración triangular 0,100 / 0,200 / 0,400 h [S-43]. Recurso: Encargado de laboratorio</bpmn:documentation>
      <bpmn:incoming>Flujo_6</bpmn:incoming>
      <bpmn:outgoing>Flujo_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="t1" name="Esperar la atención de la DTI">
      <bpmn:documentation>Duración triangular 4,000 / 16,000 / 48,000 h [S-43]</bpmn:documentation>
      <bpmn:incoming>Flujo_8</bpmn:incoming>
      <bpmn:outgoing>Flujo_9</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Temp_t1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT16H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="b4" name="Aplicar el cambio en la red o en el filtrado">
      <bpmn:documentation>Duración triangular 0,250 / 0,500 / 1,000 h [S-43]. Recurso: Técnico DTI Soporte</bpmn:documentation>
      <bpmn:incoming>Flujo_9</bpmn:incoming>
      <bpmn:outgoing>Flujo_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="b5" name="Descargar el material desde Internet en cada PC">
      <bpmn:documentation>Duración calculada en gestion/e4/procesos.py (wan_lab)</bpmn:documentation>
      <bpmn:incoming>Flujo_7</bpmn:incoming>
      <bpmn:incoming>Flujo_10</bpmn:incoming>
      <bpmn:outgoing>Flujo_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="b6" name="Verificar el material PC por PC">
      <bpmn:documentation>Duración triangular 0,020 / 0,040 / 0,080 h [S-43] por PC. Recurso: Encargado de laboratorio</bpmn:documentation>
      <bpmn:incoming>Flujo_11</bpmn:incoming>
      <bpmn:outgoing>Flujo_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin" name="Laboratorio preparado, sin registro">
      <bpmn:incoming>Flujo_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_1" sourceRef="ini" targetRef="b1"/>
    <bpmn:sequenceFlow id="Flujo_2" sourceRef="b1" targetRef="g0"/>
    <bpmn:sequenceFlow id="Flujo_3" name="Sí" sourceRef="g0" targetRef="b2"/>
    <bpmn:sequenceFlow id="Flujo_4" name="No, el mismo día" sourceRef="g0" targetRef="b2"/>
    <bpmn:sequenceFlow id="Flujo_5" sourceRef="b2" targetRef="g1"/>
    <bpmn:sequenceFlow id="Flujo_6" name="Sí" sourceRef="g1" targetRef="b3"/>
    <bpmn:sequenceFlow id="Flujo_7" name="No" sourceRef="g1" targetRef="b5"/>
    <bpmn:sequenceFlow id="Flujo_8" sourceRef="b3" targetRef="t1"/>
    <bpmn:sequenceFlow id="Flujo_9" sourceRef="t1" targetRef="b4"/>
    <bpmn:sequenceFlow id="Flujo_10" sourceRef="b4" targetRef="b5"/>
    <bpmn:sequenceFlow id="Flujo_11" sourceRef="b5" targetRef="b6"/>
    <bpmn:sequenceFlow id="Flujo_12" sourceRef="b6" targetRef="fin"/>
    <bpmn:textAnnotation id="Anot_PD_05"><bpmn:text>PD-05: Pedido informal, a menudo el mismo día de la clase</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_PD_05" sourceRef="Anot_PD_05" targetRef="b1" associationDirection="None"/>
    <bpmn:textAnnotation id="Anot_PD_06"><bpmn:text>PD-06: Toda fuente nueva o cambio de acceso espera a la DTI</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_PD_06" sourceRef="Anot_PD_06" targetRef="b3" associationDirection="None"/>
    <bpmn:textAnnotation id="Anot_PD_07"><bpmn:text>PD-07: Las 40 PCs descargan el material durante la preparación o la clase</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_PD_07" sourceRef="Anot_PD_07" targetRef="b5" associationDirection="None"/>
    <bpmn:textAnnotation id="Anot_PD_08"><bpmn:text>PD-08: Verificación del material PC por PC</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_PD_08" sourceRef="Anot_PD_08" targetRef="b6" associationDirection="None"/>
    <bpmn:textAnnotation id="Anot_PD_09"><bpmn:text>PD-09: El pedido y su resultado no se registran</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Asoc_PD_09" sourceRef="Anot_PD_09" targetRef="fin" associationDirection="None"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama_1">
    <bpmndi:BPMNPlane id="Plano_1" bpmnElement="Colaboracion_P2_AS_IS">
      <bpmndi:BPMNShape id="Participante_Campus_di" bpmnElement="Participante_Campus" isHorizontal="true" bioc:fill="#DCE5EF" bioc:stroke="#003865" color:background-color="#DCE5EF" color:border-color="#003865">
