      <bpmndi:BPMNShape id="Participante_Internet_di" bpmnElement="Participante_Internet" isHorizontal="true" bioc:fill="#DCE5EF" bioc:stroke="#003865" color:background-color="#DCE5EF" color:border-color="#003865">
