{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "infra/centro_datos.yaml (CE0331)",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "contexto", "figuras", "referencia_hibrida", "objetivos", "host", "almacenamiento", "hipervisor_red", "maquinas_virtuales", "totales_d24", "orden_arranque", "rack", "energia", "dimensionamiento", "aws", "continuidad"],
  "properties": {
    "meta": {"type": "object", "required": ["version", "fecha", "entregable", "inventario"]},
    "figuras": {"type": "object"},
    "referencia_hibrida": {"type": "object"},
    "contexto": {"type": "object", "required": ["problema", "onpremise", "cloud", "criterio_reparto", "alcance_excluye"]},
    "objetivos": {"type": "array", "minItems": 5, "items": {"type": "object", "required": ["id", "objetivo", "indicador", "meta", "verificable", "responsable"]}},
    "host": {"type": "object", "required": ["componente", "hipervisor", "cpu", "ram_gb", "nic", "vmk"],
      "properties": {
        "hipervisor": {"type": "object", "required": ["producto", "version", "vcpu_max_por_vm", "vcenter", "vadp", "limites"]},
        "cpu": {"type": "object", "required": ["nucleos"]},
        "ram_gb": {"type": "number", "exclusiveMinimum": 0},
        "nic": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "required": ["id", "velocidad_gbps", "uso", "vswitch", "destino"]}}
      }},
    "almacenamiento": {"type": "object", "required": ["datastores"],
      "properties": {"datastores": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["id", "nombre", "medio", "capacidad_gb", "raid", "contiene", "criticidad", "fase", "por_que", "si_falla"], "properties": {"criticidad": {"enum": ["Alta", "Media", "Baja"]}}}}}},
    "hipervisor_red": {"type": "object", "required": ["seguridad_por_defecto", "vswitches"],
      "properties": {"vswitches": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["id", "uplinks", "teaming", "uso", "port_groups"],
        "properties": {"port_groups": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "vlan", "zona"]}}}}}}},
    "maquinas_virtuales": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["componente", "fase", "vcpu", "ram_gb", "disco_gb", "cache_gb", "so", "port_groups", "datastore", "sensible"],
      "properties": {"fase": {"enum": ["F1", "F2"]}, "vcpu": {"type": "integer", "minimum": 1}, "ram_gb": {"type": "number", "minimum": 1}, "disco_gb": {"type": "number", "minimum": 1}, "cache_gb": {"type": "number", "minimum": 0}, "port_groups": {"type": "array", "minItems": 1}}}},
    "totales_d24": {"type": "object", "required": ["F1", "F2"]},
    "orden_arranque": {"type": "array"},
    "vm_fisicas_excluidas": {"type": "object"},
    "rack": {"type": "object", "required": ["unidades", "ocupacion", "elementos"]},
    "energia": {"type": "object", "required": ["ups", "capacidad_kva", "consumo_w", "autonomia_min", "nut"]},
    "dimensionamiento": {"type": "object", "required": ["fase", "razones_overcommit", "sobrecarga_esxi", "crecimiento", "factor_disco", "copia_local_restic_gb", "holgura_minima"]},
    "aws": {"type": "object", "required": ["region", "elementos", "instancias", "nat", "costo_mensual"]},
    "continuidad": {"type": "object", "required": ["limites_por_criticidad", "servicios", "regla_3_2_1_1_0", "punto_unico_de_falla"],
      "properties": {"servicios": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "servicio", "componentes", "redundancia", "respaldo", "rto_min", "rto_texto", "rpo_min", "rpo_texto"]}}}}
  }
}
