{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "celeris/inventory.schema.json",
  "title": "Inventario de red Celeris (CE0311)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "supernets",
    "reservas",
    "zonas",
    "servicios_base",
    "vpn",
    "componentes",
    "flujos",
    "matriz_esperada"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "inventario_version",
        "fecha",
        "documento_base"
      ],
      "properties": {
        "inventario_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        },
        "fecha": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "supernets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "cidr",
          "descripcion"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "cidr": {
            "type": "string",
            "minLength": 1
          },
          "descripcion": {
            "type": "string"
          },
          "resumen": {
            "type": "boolean"
          }
        }
      }
    },
    "reservas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "cidr",
          "dentro_de"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "cidr": {
            "type": "string",
            "minLength": 1
          },
          "dentro_de": {
            "type": "string",
            "minLength": 1
          },
          "descripcion": {
            "type": "string"
          }
        }
      }
    },
    "zonas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nombre",
          "tipo",
          "vlan",
          "cidr",
          "gateway",
          "confianza",
          "proposito",
          "regla_diseno",
          "admin",
          "color"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$"
          },
          "nombre": {
            "type": "string",
            "minLength": 1
          },
          "tipo": {
            "enum": [
              "interna",
              "reservada",
              "perimetro",
              "nube",
              "externa"
            ]
          },
          "vlan": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 4094
          },
          "cidr": {
            "type": [
              "string",
              "null"
            ]
          },
          "gateway": {
            "type": [
              "string",
              "null"
            ]
          },
          "hosts_utiles": {
            "type": "integer",
            "minimum": 1
          },
          "confianza": {
            "enum": [
              "Máxima",
              "Alta",
              "Media",
              "Baja",
              "Nula",
              "Aislada"
            ]
          },
          "confianza_nota": {
            "type": "string"
          },
          "proposito": {
            "type": "string",
            "minLength": 1
          },
          "regla_diseno": {
            "type": "string",
            "minLength": 1
          },
          "admin": {
            "type": "string",
            "minLength": 1
          },
          "color": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              }
            ]
          },
          "estilo": {
            "type": "string"
          },
          "excepcion_convencion_vlan": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    },
    "servicios_base": {
      "type": "object",
      "required": [
        "dhcp",
        "dns",
        "pac",
        "ntp",
        "ipv6",
        "dns_cifrado"
      ]
    },
    "vpn": {
      "type": "object",
      "required": [
        "dispositivos",
        "extremo_onpremise",
        "extremo_aws",
        "tuneles",
        "bgp",
        "fase1",
        "fase2",
        "dpd",
        "mtu",
        "mss_clamping",
        "secretos"
      ]
    },
    "componentes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nombre",
          "tipo",
          "zonas",
          "ips",
          "funcion",
          "criticidad",
          "estado",
          "por_que",
          "aporta_corto",
          "aporta",
          "si_falla",
          "dependencias",
          "controles",
          "adr",
          "req",
          "objetivos",
          "figuras",
          "supuestos",
          "emulacion_lab"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$"
          },
          "nombre": {
            "type": "string",
            "minLength": 1
          },
          "tipo": {
            "enum": [
              "firewall",
              "switch",
              "switch_existente",
              "puerto_emergencia",
              "hipervisor",
              "gestion_fuera_banda",
              "ups",
              "servidor",
              "ids",
              "honeypot",
              "waf",
              "web",
              "cliente_prueba",
              "nas",
              "interfaz_tunel",
              "vpn_gateway",
              "aws_instancia",
              "aws_vpc",
              "aws_subred"
            ]
          },
          "zonas": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$"
            },
            "minItems": 1
          },
          "ips": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "interfaz",
                "ip",
                "zona"
              ],
              "properties": {
                "interfaz": {
                  "type": "string",
                  "minLength": 1
                },
                "ip": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "zona": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$"
                },
                "criticidad": {
                  "enum": [
                    "Alta",
                    "Media",
                    "Baja"
                  ]
                },
                "nota": {
                  "type": "string"
                }
              }
            }
          },
          "cidr": {
            "type": "string"
          },
          "subred": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$"
          },
          "az": {
            "enum": [
              "a",
              "b"
            ]
          },
          "subred_tipo": {
            "enum": [
              "publica",
              "privada"
            ]
          },
          "funcion": {
            "type": "string",
            "minLength": 1
          },
          "criticidad": {
            "enum": [
              "Alta",
              "Media",
              "Baja"
            ]
          },
          "estado": {
            "enum": [
              "diseño",
              "existente",
              "fuera_de_alcance",
              "emulado_en_lab"
            ]
          },
          "vm": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fase",
              "vcpu",
              "ram_gb",
              "disco_gb",
              "so",
              "port_group"
            ],
            "properties": {
              "fase": {
                "enum": [
                  "F1",
                  "F2"
                ]
              },
              "vcpu": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "ram_gb": {
                "type": "integer",
                "minimum": 1
              },
              "disco_gb": {
                "type": [
                  "integer",
                  "string"
                ]
              },
              "so": {
                "type": "string",
                "minLength": 1
              },
              "port_group": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "por_que": {
            "type": "string",
            "minLength": 1
          },
          "aporta_corto": {
            "type": "string",
            "minLength": 1
          },
          "aporta": {
            "type": "string",
            "minLength": 1
          },
          "si_falla": {
            "type": "string",
            "minLength": 1
          },
          "dependencias": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$"
            }
          },
          "controles": {
            "type": "string",
            "minLength": 1
          },
          "adr": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^D-\\d{2}$"
            }
          },
          "req": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-(F|NF|RN)-\\d{2}$"
            }
          },
          "objetivos": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^OD-\\d{2}$"
            }
          },
          "figuras": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^FIG-\\d\\.\\d(a|b)?$"
            }
          },
          "supuestos": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^S-\\d{2}$"
            }
          },
          "flujos_justificacion": {
            "type": "string",
            "minLength": 1
          },
          "emulacion_lab": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nodo",
              "equivalencia",
              "nota"
            ],
            "properties": {
              "nodo": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "equivalencia": {
                "enum": [
                  "mismo_producto",
                  "funcional",
                  "no_emulado"
                ]
              },
              "nota": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "pendiente": {
            "type": "boolean"
          },
          "cambio": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^CI-\\d{2}$"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^CI-\\d{2}$"
                },
                "minItems": 1
              }
            ]
          }
        }
      },
      "minItems": 1
    },
    "flujos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "estado",
          "origen",
          "destino",
          "protocolos",
          "proposito",
          "accion",
          "proteccion",
          "riesgo_residual",
          "modo",
          "regla_fw",
          "figura",
          "objetivos",
          "adr",
          "req"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F([1-9]|1[0-9]|2[0-6])$"
          },
          "estado": {
            "enum": [
              "activo",
              "reservado"
            ]
          },
          "origen": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "destino": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "destino_detalle": {
            "type": "string"
          },
          "protocolos": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "proto",
                "puertos"
              ],
              "properties": {
                "proto": {
                  "enum": [
                    "tcp",
                    "udp",
                    "icmp",
                    "ipv6"
                  ]
                },
                "puertos": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                },
                "nota": {
                  "type": "string"
                },
                "dnat": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              }
            }
          },
          "proposito": {
            "type": "string",
            "minLength": 1
          },
          "accion": {
            "enum": [
              "permitir",
              "bloquear",
              null
            ]
          },
          "proteccion": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "tipo",
              "detalle"
            ],
            "properties": {
              "tipo": {
                "enum": [
                  "tls",
                  "mtls",
                  "tls_en_ipsec",
                  "mtls_en_ipsec",
                  "ssh",
                  "cifrado_aplicacion",
                  "sin_cifrar_riesgo_aceptado",
                  "no_aplica"
                ]
              },
              "detalle": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "riesgo_residual": {
            "type": [
              "string",
              "null"
            ]
          },
          "modo": {
            "enum": [
              "piloto",
              "gestionado",
              "ambos",
              null
            ]
          },
          "regla_fw": {
            "type": [
              "string",
              "null"
            ]
          },
          "figura": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^FIG-\\d\\.\\d(a|b)?$"
              }
            ]
          },
          "objetivos": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^OD-\\d{2}$"
            }
          },
          "adr": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^D-\\d{2}$"
            }
          },
          "req": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-(F|NF|RN)-\\d{2}$"
            }
          },
          "sin_prueba_justificacion": {
            "type": "string",
            "minLength": 1
          },
          "pendiente": {
            "type": "boolean"
          },
          "cambio": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^CI-\\d{2}$"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^CI-\\d{2}$"
                },
                "minItems": 1
              }
            ]
          },
          "nota": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    },
    "matriz_esperada": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orden",
        "celdas"
      ],
      "properties": {
        "orden": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$"
          },
          "minItems": 2
        },
        "celdas": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "estado"
              ],
              "properties": {
                "estado": {
                  "enum": [
                    "permitido",
                    "denegado",
                    "no_aplica"
                  ]
                },
                "flujos": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^F([1-9]|1[0-9]|2[0-6])$"
                  }
                },
                "bloqueados": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^F([1-9]|1[0-9]|2[0-6])$"
                  }
                },
                "nota": {
                  "type": "string"
                },
                "pendiente": {
                  "type": "boolean"
                },
                "cambio": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^CI-\\d{2}$"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^CI-\\d{2}$"
                      },
                      "minItems": 1
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
